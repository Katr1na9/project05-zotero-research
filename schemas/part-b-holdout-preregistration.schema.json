        "labels_visible_at_freeze": {"const": false},
        "results_visible_at_freeze": {"const": false},
        "roster_mutation_after_freeze": {"const": false},
        "parameter_mutation_after_freeze": {"const": false},
        "endpoint_mutation_after_freeze": {"const": false},
        "estimand_mutation_after_freeze": {"const": false},
        "method_mutation_after_freeze": {"const": false}
      }
