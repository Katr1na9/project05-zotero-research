  "$defs": {
    "accessBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_data_loaded",
        "holdout_labels_loaded",
        "holdout_results_loaded",
        "statistics_computed"
      ],
      "properties": {
        "holdout_data_loaded": {"const": false},
        "holdout_labels_loaded": {"const": false},
        "holdout_results_loaded": {"const": false},
        "statistics_computed": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
