        "baseline_ids": {
          "const": [
            "NO_ACQUISITION",
            "RANDOM_FEASIBLE",
            "COVERAGE_GREEDY",
            "CMI_PROXY",
            "M1_STATIC_EXPECTED_GAIN",
            "M2_TRANSPARENT",
            "M3A_GAP_COMPATIBILITY",
            "LOGISTIC_M3B",
            "XGBOOST_ACTION_VALUE",
            "AFA_VOI_MYOPIC",
            "AFA_VOI_ROLLOUT_H3",
            "DEPTH2_PUBLIC",
            "ORACLE_EVALUATION_ONLY"
          ]
        },
