      "required": [
        "freeze_state",
        "labels_visible_at_freeze",
        "results_visible_at_freeze",
        "roster_mutation_after_freeze",
        "parameter_mutation_after_freeze",
        "endpoint_mutation_after_freeze",
        "estimand_mutation_after_freeze",
        "method_mutation_after_freeze"
