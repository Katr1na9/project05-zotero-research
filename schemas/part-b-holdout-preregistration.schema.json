{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-holdout-preregistration.schema.json",
  "title": "Project05 Part B B8 holdout preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preregistration_id",
    "preregistration_version",
    "status",
    "authorized_slice",
    "analysis_id",
    "partition_id",
    "analysis_registry",
    "split_commitment",
    "freeze",
    "b4_roster_binding",
    "access_boundary",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "preregistration_id": {
      "const": "part-b-holdout-preregistration-v0.8"
    },
    "preregistration_version": {"const": "0.8.0"},
    "status": {"const": "B8_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B8_HOLDOUT_ANALYSIS"},
    "analysis_id": {"const": "HOLDOUT-ANALYSIS-V0.8-001"},
    "partition_id": {"const": "HOLDOUT"},
