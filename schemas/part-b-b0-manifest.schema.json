{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-b0-manifest.schema.json",
  "title": "Project05 Part B B0 planning and contracts manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "status",
    "authorized_slice",
    "execution_authority",
    "llm_integration",
    "stop_authority",
    "closed_slices",
    "bindings",
    "runtime_authority",
    "allowed_outputs",
    "error_semantics",
    "next_gate",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "manifest_id": {"const": "part-b-b0-manifest-v0.8"},
    "manifest_version": {"const": "0.8.0"},
    "status": {"const": "B0_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B0_PLANNING_AND_CONTRACTS"},
    "execution_authority": {"const": false},
    "llm_integration": {"const": "FORBIDDEN"},
    "stop_authority": {"const": "NONE"},
    "closed_slices": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"const": "B1"}, {"const": "B2"}, {"const": "B3"},
        {"const": "B4"}, {"const": "B5"}, {"const": "B6"},
        {"const": "B7"}, {"const": "B8"}, {"const": "B9"}
      ],
      "items": false
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_gamma_hash",
        "kernel_catalog_hash",
        "admission_policy_hash",
        "approval_manifest_hash",
        "observation_contract_hash",
        "cost_contract_hash"
      ],
      "properties": {
        "kernel_gamma_hash": {"$ref": "#/$defs/sha256"},
        "kernel_catalog_hash": {"$ref": "#/$defs/sha256"},
        "admission_policy_hash": {"$ref": "#/$defs/sha256"},
        "approval_manifest_hash": {"$ref": "#/$defs/sha256"},
        "observation_contract_hash": {"$ref": "#/$defs/sha256"},
        "cost_contract_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stochastic_execution",
        "broad_connectors",
        "planner",
        "m3star",
        "baselines",
        "cost_superiority_claims"
      ],
      "properties": {
        "stochastic_execution": {"const": false},
        "broad_connectors": {"const": false},
        "planner": {"const": false},
        "m3star": {"const": false},
        "baselines": {"const": false},
        "cost_superiority_claims": {"const": false}
      }
    },
    "allowed_outputs": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "error_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_only",
        "outside_frozen_domain",
        "timeout",
        "resource_exhaustion",
        "infeasible",
        "unauthorized_component"
      ],
      "properties": {
        "contract_only": {"const": "B0-CONTRACT-001_NO_EXECUTION_AUTHORITY"},
        "outside_frozen_domain": {"const": "B0-CONTRACT-002_OUTSIDE_FROZEN_DOMAIN"},
        "timeout": {"const": "B0-CONTRACT-003_UNKNOWN_TIMEOUT"},
        "resource_exhaustion": {"const": "B0-CONTRACT-004_UNKNOWN_RESOURCE_EXHAUSTED"},
        "infeasible": {"const": "B0-CONTRACT-005_INFEASIBLE_SEPARATE_FROM_COST"},
        "unauthorized_component": {"const": "B0-CONTRACT-006_UNAUTHORIZED_COMPONENT"}
      }
    },
    "next_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_explicit_user_authorization", "requires_contract_approval", "default"],
      "properties": {
        "requires_explicit_user_authorization": {"const": true},
        "requires_contract_approval": {"const": true},
        "default": {"const": "STOP_AFTER_B0_REVIEW"}
      }
    },
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
