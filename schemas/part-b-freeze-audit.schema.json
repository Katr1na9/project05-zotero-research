{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-freeze-audit.schema.json",
  "title": "Project05 Part B B9 freeze audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "audit_version",
    "status",
    "authorized_slice",
    "evidence_ceiling",
    "bindings",
    "checks",
    "evidence_inventory",
    "gate_states",
    "outputs",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "audit_id": {"const": "part-b-freeze-audit-example-v0.8"},
    "audit_version": {"const": "0.8.0"},
    "status": {"const": "B9_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B9_FREEZE_AND_CLAIMS"},
    "evidence_ceiling": {"const": "CONTRACT_CONSISTENCY_ONLY"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze_record_hash",
        "freeze_and_claims_policy_hash",
        "claim_boundary_hash",
        "b9_manifest_hash"
      ],
      "properties": {
        "freeze_record_hash": {"$ref": "#/$defs/sha256"},
        "freeze_and_claims_policy_hash": {"$ref": "#/$defs/sha256"},
        "claim_boundary_hash": {"$ref": "#/$defs/sha256"},
        "b9_manifest_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_artifact_count",
        "frozen_paths_resolve",
        "frozen_hashes_replay",
        "schemas_validate",
        "claim_boundary_validates",
        "upstream_content_rewritten"
      ],
      "properties": {
        "frozen_artifact_count": {"const": 39},
        "frozen_paths_resolve": {"const": true},
        "frozen_hashes_replay": {"const": true},
        "schemas_validate": {"const": true},
        "claim_boundary_validates": {"const": true},
        "upstream_content_rewritten": {"const": false}
      }
    },
    "evidence_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_source_data_present",
        "holdout_data_present",
        "holdout_labels_present",
        "holdout_results_present",
        "statistics_present",
        "metrics_present",
        "rankings_present",
        "execution_trace_present"
      ],
      "properties": {
        "real_source_data_present": {"const": false},
        "holdout_data_present": {"const": false},
        "holdout_labels_present": {"const": false},
        "holdout_results_present": {"const": false},
        "statistics_present": {"const": false},
        "metrics_present": {"const": false},
        "rankings_present": {"const": false},
        "execution_trace_present": {"const": false}
      }
    },
    "gate_states": {"$ref": "#/$defs/gateStates"},
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_issued",
        "system_status_emitted",
        "certified_stop_emitted",
        "performance_claim_released"
      ],
      "properties": {
        "certificate_issued": {"const": false},
        "system_status_emitted": {"const": false},
        "certified_stop_emitted": {"const": false},
        "performance_claim_released": {"const": false}
      }
    },
    "limitations": {"$ref": "#/$defs/limitations"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gateStates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PB-SI-006",
        "PB-B5-SI-001",
        "PB-B8-SI-004",
        "HOLDOUT_RELEASE",
        "STATISTICAL_EXECUTION",
        "IMPLEMENTATION_ADMISSION"
      ],
      "properties": {
        "PB-SI-006": {
          "const": "OPEN_BLOCKS_CONNECTOR_DATA_HOLDOUT_ACCESS"
        },
        "PB-B5-SI-001": {
          "const": "OPEN_BLOCKS_IMPLEMENTATION_ADMISSION_AND_EXECUTION"
        },
        "PB-B8-SI-004": {
          "const": "OPEN_REQUIRES_SEPARATE_EXECUTION_EVIDENCE"
        },
        "HOLDOUT_RELEASE": {"const": "OPEN_DEFAULT_DENY"},
        "STATISTICAL_EXECUTION": {"const": "OPEN_NOT_AUTHORIZED"},
        "IMPLEMENTATION_ADMISSION": {"const": "OPEN_NOT_ESTABLISHED"}
      }
    }
  }
}
