{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.invalid/schemas/claim-ir-external-envelope-evidence-v0.2.schema.json",
  "title": "Project05 external Claim IR evidence envelope v0.2",
  "description": "A3 GREEN candidate identity. It preserves the exact evidence-v0.1 record branch and adds only unminted, not-admitted audit-log public declarations. Structural validity is not truth, sufficiency, ingestion, or admission authority.",
  "x-status": "candidate_effective_pending_kernel_owner_a3_green_acceptance",
  "x-authority-base-commit": "ea04056e4121cea02a70ca588a42b9bef843078d",
  "x-red-owner-acceptance": {
    "path": "docs/kernel/kernel-v0.8-m1-audit-log-evidence-modality-red-owner-acceptance-v0.1-20260727.json",
    "sha256": "2113590604e86ef82694b5c98632fb8f1132f1c2c88e54398a02a24f9f30b4a5"
  },
  "x-preserved-evidence-v0.1": {
    "path": "schemas/claim-ir-external-envelope-evidence-v0.1.schema.json",
    "sha256": "9abc23e2258298038e137dbbe38168867d07108fa27719aa68c1c2b752ae2a7c",
    "modified": false
  },
  "x-audit-log-boundary": {
    "source_class": "audit_log_public_projection",
    "claim_namespace": "evidence.audit_log.*",
    "claim_ceiling": "PUBLIC_AUDIT_DECLARATION_ONLY",
    "reported_outcome_is_truth_or_authority": false,
    "a2_sufficiency_catalog_extended": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "surface_id",
    "kernel_state",
    "claim_id_state",
    "admission_state",
    "projection_ref",
    "claims",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "claim-ir-external-evidence-v0.2"
    },
    "package_id": {
      "type": "string",
      "pattern": "^pkg_[A-Za-z0-9_-]{16,128}$"
    },
    "surface_id": {
      "type": "string",
      "const": "project05_depth2_public"
    },
    "kernel_state": {
      "type": "string",
      "const": "pending_kernel_schema"
    },
    "claim_id_state": {
      "type": "string",
      "const": "not_minted"
    },
    "admission_state": {
      "type": "string",
      "const": "not_admitted"
    },
    "projection_ref": {
      "$ref": "#/$defs/evidence_projection_ref_v0_2"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/evidence_claim_record_v0_2"
      }
    },
    "manifest": {
      "$ref": "#/$defs/evidence_manifest_v0_2"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "projection_ref": {
            "properties": {
              "source_class": {
                "const": "system_log_public_projection"
              }
            },
            "required": ["source_class"]
          }
        },
        "required": ["projection_ref"]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence_claim_record_v0_2"
                },
                {
                  "properties": {
                    "source_class": {
                      "const": "system_log_public_projection"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projection_ref": {
            "properties": {
              "source_class": {
                "const": "provenance_graph_public_projection"
              }
            },
            "required": ["source_class"]
          }
        },
        "required": ["projection_ref"]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence_claim_record_v0_2"
                },
                {
                  "properties": {
                    "source_class": {
                      "const": "provenance_graph_public_projection"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projection_ref": {
            "properties": {
              "source_class": {
                "const": "cti_report_public_projection"
              }
            },
            "required": ["source_class"]
          }
        },
        "required": ["projection_ref"]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence_claim_record_v0_2"
                },
                {
                  "properties": {
                    "source_class": {
                      "const": "cti_report_public_projection"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projection_ref": {
            "properties": {
              "source_class": {
                "const": "audit_log_public_projection"
              }
            },
            "required": ["source_class"]
          }
        },
        "required": ["projection_ref"]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence_claim_record_v0_2"
                },
                {
                  "properties": {
                    "source_class": {
                      "const": "audit_log_public_projection"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_projection_ref_v0_2": {
      "oneOf": [
        {
          "$ref": "https://project05.invalid/schemas/claim-ir-external-envelope-evidence-v0.1.schema.json#/$defs/evidence_projection_ref"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "surface_id",
            "source_class"
          ],
          "properties": {
            "path": {
              "const": "docs/llm-editor/llm-editor-v0.8-l2-m1-audit-log-public-field-projection-v0.1-20260727.json"
            },
            "sha256": {
              "const": "93e0d63010eff7e05559d0ca28a00a6b8ab5ce37ed7c469ede09b5c1bf893625"
            },
            "surface_id": {
              "const": "project05_depth2_public"
            },
            "source_class": {
              "const": "audit_log_public_projection"
            }
          }
        }
      ]
    },
    "evidence_field_v0_2": {
      "oneOf": [
        {
          "$ref": "https://project05.invalid/schemas/claim-ir-external-envelope-evidence-v0.1.schema.json#/$defs/evidence_field"
        },
        {
          "type": "string",
          "pattern": "^evidence\\.audit_log\\.[a-z0-9_.]+$"
        }
      ]
    },
    "evidence_claim_record_v0_2": {
      "oneOf": [
        {
          "$ref": "https://project05.invalid/schemas/claim-ir-external-envelope-evidence-v0.1.schema.json#/$defs/evidence_claim_record_v0_1"
        },
        {
          "$ref": "#/$defs/audit_log_evidence_claim_record_v0_1"
        }
      ]
    },
    "evidence_manifest_v0_2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_count",
        "field_path_set",
        "evidence_field_path_set",
        "projection_sha256",
        "content_hash"
      ],
      "properties": {
        "claim_count": {
          "type": "integer",
          "minimum": 1
        },
        "field_path_set": {
          "type": "array",
          "maxItems": 0,
          "description": "Legacy planner source_field remains empty for evidence-only packages."
        },
        "evidence_field_path_set": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_field_v0_2"
          }
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "audit_log_evidence_claim_record_v0_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_class",
        "claim_id",
        "claim_id_state",
        "claim_kind",
        "evidence_field",
        "occurrence_key",
        "value_type",
        "value",
        "source_class",
        "source_record_ref",
        "epistemic_modality",
        "modality_basis_code",
        "trusted_ingestion_metadata_sha256",
        "admission_state"
      ],
      "properties": {
        "record_class": {
          "const": "public_evidence_declaration"
        },
        "claim_id": {
          "type": "null"
        },
        "claim_id_state": {
          "const": "not_minted"
        },
        "claim_kind": {
          "enum": [
            "evidence.audit_log.entry_identity",
            "evidence.audit_log.time_boundary",
            "evidence.audit_log.operation_declaration",
            "evidence.audit_log.target_declaration",
            "evidence.audit_log.outcome_declaration",
            "evidence.audit_log.recorded_marker",
            "evidence.audit_log.actor_reference",
            "evidence.audit_log.change_reference",
            "evidence.audit_log.request_reference"
          ]
        },
        "evidence_field": {
          "type": "string",
          "pattern": "^evidence\\.audit_log\\.[a-z0-9_.]+$"
        },
        "occurrence_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._:|-]+$"
        },
        "value_type": {
          "enum": [
            "opaque_reference",
            "bounded_enum",
            "bounded_public_text",
            "bounded_boolean"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "boolean"
            }
          ]
        },
        "source_class": {
          "const": "audit_log_public_projection"
        },
        "source_record_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        },
        "epistemic_modality": {
          "enum": [
            "reported",
            "unknown"
          ]
        },
        "modality_basis_code": {
          "enum": [
            "PUBLIC_AUDIT_RECORD_DECLARATION",
            "UNRESOLVED_AUDIT_BASIS"
          ]
        },
        "trusted_ingestion_metadata_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "admission_state": {
          "const": "not_admitted"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "bounded_boolean"
              }
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "opaque_reference",
                  "bounded_enum",
                  "bounded_public_text"
                ]
              }
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "opaque_reference"
              }
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,256}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "bounded_enum"
              }
            },
            "required": ["value_type"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "epistemic_modality": {
                "const": "reported"
              }
            },
            "required": ["epistemic_modality"]
          },
          "then": {
            "properties": {
              "modality_basis_code": {
                "const": "PUBLIC_AUDIT_RECORD_DECLARATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "epistemic_modality": {
                "const": "unknown"
              }
            },
            "required": ["epistemic_modality"]
          },
          "then": {
            "properties": {
              "modality_basis_code": {
                "const": "UNRESOLVED_AUDIT_BASIS"
              }
            }
          }
        }
      ]
    }
  }
}
