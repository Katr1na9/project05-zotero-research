{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/certificate.schema.json",
  "title": "Project05 v0.8 Kernel Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_id",
    "case_id",
    "issued_by",
    "gamma_hash",
    "evidence_hash",
    "level",
    "conclusion",
    "certification_scope",
    "candidate_coverage",
    "core_query_results",
    "level_certification",
    "positive_witness",
    "proof_artifact",
    "critical_scope_assumptions",
    "promotion_dependencies",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "certificate_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "issued_by": {"const": "kernel_checker"},
    "gamma_hash": {"$ref": "#/$defs/sha256"},
    "evidence_hash": {"$ref": "#/$defs/sha256"},
    "level": {"type": "string", "minLength": 1},
    "conclusion": {"$ref": "#/$defs/entityRef"},
    "certification_scope": {"enum": ["candidate_level", "level_complete"]},
    "candidate_coverage": {"$ref": "#/$defs/candidateCoverage"},
    "core_query_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "support", "alternative"],
      "properties": {
        "base": {"const": "SAT"},
        "support": {"const": "SAT"},
        "alternative": {"const": "UNSAT"}
      }
    },
    "level_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_legal_results_covered", "exactly_one_feasible_result", "all_critical_queries_known"],
      "properties": {
        "all_legal_results_covered": {"type": "boolean"},
        "exactly_one_feasible_result": {"type": "boolean"},
        "all_critical_queries_known": {"type": "boolean"}
      }
    },
    "positive_witness": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "proof_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_level", "solver", "solver_version", "query_hashes", "artifact_uri"],
      "properties": {
        "proof_level": {"enum": ["reproducible_run", "solver_proof", "independently_checked"]},
        "solver": {"enum": ["finite_domain_enumerator", "small_csp"]},
        "solver_version": {"type": "string", "minLength": 1},
        "query_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"},
          "uniqueItems": true
        },
        "artifact_uri": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "critical_scope_assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "promotion_dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["valid", "invalidated", "revoked"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"certification_scope": {"const": "level_complete"}},
        "required": ["certification_scope"]
      },
      "then": {
        "properties": {
          "candidate_coverage": {
            "properties": {"mode": {"enum": ["exhaustive", "solver_complete"]}}
          },
          "level_certification": {
            "properties": {
              "all_legal_results_covered": {"const": true},
              "exactly_one_feasible_result": {"const": true},
              "all_critical_queries_known": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1}
      }
    },
    "candidateCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "mode", "declared_domain_size", "checked_count", "omitted_known_candidates", "solver_seed_used"],
      "properties": {
        "level": {"type": "string", "minLength": 1},
        "mode": {"enum": ["exhaustive", "solver_complete", "heuristic"]},
        "declared_domain_size": {"type": ["integer", "null"], "minimum": 0},
        "checked_count": {"type": "integer", "minimum": 0},
        "omitted_known_candidates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "solver_seed_used": {"type": "boolean"}
      }
    }
  }
}
