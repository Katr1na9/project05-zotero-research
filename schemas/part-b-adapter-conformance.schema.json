{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-adapter-conformance.schema.json",
  "title": "Project05 Part B B1 adapter-conformance contract",
  "description": "Non-executable examples for provenance-preserving projections into a Claim IR envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "status",
    "authorized_slice",
    "execution_authority",
    "federation_contract_hash",
    "adapter_rules",
    "error_semantics",
    "conformance_examples",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "contract_id": {"const": "part-b-adapter-conformance-v0.8"},
    "contract_version": {"const": "0.8.0"},
    "status": {"const": "B1_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B1_FEDERATION_SCHEMAS"},
    "execution_authority": {"const": false},
    "federation_contract_hash": {"$ref": "#/$defs/sha256"},
    "adapter_rules": {"$ref": "#/$defs/adapterRules"},
    "error_semantics": {"$ref": "#/$defs/errorSemantics"},
    "conformance_examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/conformanceExample"}
    },
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "certificationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "levels", "basis_rule_id", "policy_hash"],
      "properties": {
        "allowed": {"const": false},
        "levels": {"type": "array", "maxItems": 0},
        "basis_rule_id": {"type": "null"},
        "policy_hash": {"type": "null"}
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end", "end_semantics"],
      "properties": {
        "kind": {"enum": ["ROWS", "BYTES"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "end_semantics": {"const": "EXCLUSIVE"}
      }
    },
    "inputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "record_id",
        "content_hash",
        "range"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "range": {"$ref": "#/$defs/sourceRange"}
      }
    },
    "claimPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "record_id",
        "content_hash",
        "byte_or_row_range",
        "range_semantics"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "byte_or_row_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 1}
          ],
          "items": false
        },
        "range_semantics": {
          "enum": ["ROWS_HALF_OPEN", "BYTES_HALF_OPEN"]
        }
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_field", "output_field"],
      "properties": {
        "input_field": {"type": "string", "minLength": 1},
        "output_field": {
          "enum": [
            "subject.entity_id",
            "predicate",
            "object.literal",
            "time.start",
            "pointer.record_id",
            "pointer.byte_or_row_range"
          ]
        }
      }
    },
    "entityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace_id",
        "source_entity_id",
        "canonical_entity_id",
        "binding_rule_id"
      ],
      "properties": {
        "namespace_id": {"type": "string", "minLength": 1},
        "source_entity_id": {"type": "string", "minLength": 1},
        "canonical_entity_id": {"type": "string", "minLength": 1},
        "binding_rule_id": {"type": "string", "minLength": 1}
      }
    },
    "projectedClaimEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_family",
        "source_schema",
        "subject_entity_id",
        "predicate",
        "object_value",
        "pointer",
        "modality",
        "truth_status",
        "epistemic_role",
        "certification_authority"
      ],
      "properties": {
        "source_family": {
          "enum": [
            "execution",
            "identity",
            "communication",
            "data_access",
            "control_plane",
            "system_provenance",
            "software_supply_chain",
            "external_intel",
            "human_investigation"
          ]
        },
        "source_schema": {"type": "string", "minLength": 1},
        "subject_entity_id": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object_value": {
          "type": ["string", "number", "boolean"],
          "minLength": 1
        },
        "pointer": {"$ref": "#/$defs/claimPointer"},
        "modality": {
          "enum": [
            "observed",
            "derived",
            "reported",
            "hypothesized",
            "unknown"
          ]
        },
        "truth_status": {
          "enum": [
            "unassessed",
            "supported",
            "contradicted",
            "conflicted",
            "retracted"
          ]
        },
        "epistemic_role": {
          "enum": [
            "case_evidence",
            "mechanism_knowledge",
            "background_intelligence",
            "model_hypothesis",
            "analyst_hypothesis",
            "unknown"
          ]
        },
        "certification_authority": {
          "$ref": "#/$defs/certificationAuthority"
        }
      }
    },
    "entityIdentityRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace_required",
        "binding_required",
        "collision_policy",
        "collision_error_code"
      ],
      "properties": {
        "namespace_required": {"const": true},
        "binding_required": {"const": true},
        "collision_policy": {"const": "FAIL_CLOSED"},
        "collision_error_code": {"const": "B1-FED-005_NAMESPACE_COLLISION"}
      }
    },
    "adapterRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_provenance",
        "protected_fields",
        "certification_authority",
        "unknown_input_policy",
        "entity_identity"
      ],
      "properties": {
        "pointer_provenance": {"const": "PRESERVE_EXACTLY"},
        "protected_fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"const": "pointer"},
            {"const": "modality"},
            {"const": "truth_status"},
            {"const": "epistemic_role"},
            {"const": "certification_authority"}
          ],
          "items": false
        },
        "certification_authority": {
          "const": "POLICY_GATED_OUTSIDE_ADAPTER"
        },
        "unknown_input_policy": {"const": "FAIL_CLOSED_WITH_ERROR"},
        "entity_identity": {"$ref": "#/$defs/entityIdentityRules"}
      }
    },
    "errorSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_family",
        "unknown_predicate",
        "unknown_schema_version",
        "pointer_provenance_mismatch",
        "namespace_collision",
        "authority_self_grant",
        "open_world_zero_hit",
        "closed_world_incomplete",
        "unauthorized_execution"
      ],
      "properties": {
        "unknown_family": {"const": "B1-FED-001_UNKNOWN_FAMILY"},
        "unknown_predicate": {"const": "B1-FED-002_UNKNOWN_PREDICATE"},
        "unknown_schema_version": {
          "const": "B1-FED-003_UNKNOWN_SCHEMA_VERSION"
        },
        "pointer_provenance_mismatch": {
          "const": "B1-FED-004_POINTER_PROVENANCE_MISMATCH"
        },
        "namespace_collision": {
          "const": "B1-FED-005_NAMESPACE_COLLISION"
        },
        "authority_self_grant": {
          "const": "B1-FED-006_AUTHORITY_SELF_GRANT"
        },
        "open_world_zero_hit": {
          "const": "B1-FED-007_OPEN_WORLD_ZERO_HIT"
        },
        "closed_world_incomplete": {
          "const": "B1-FED-008_CLOSED_WORLD_INCOMPLETE"
        },
        "unauthorized_execution": {
          "const": "B1-FED-009_UNAUTHORIZED_EXECUTION"
        }
      }
    },
    "conformanceExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example_id",
        "family_id",
        "family_version",
        "adapter_id",
        "adapter_version",
        "input_shape",
        "input_schema_id",
        "input_provenance",
        "field_mappings",
        "entity_binding",
        "projected_claim_envelope"
      ],
      "properties": {
        "example_id": {"type": "string", "minLength": 1},
        "family_id": {
          "enum": [
            "execution",
            "identity",
            "communication",
            "data_access",
            "control_plane",
            "system_provenance",
            "software_supply_chain",
            "external_intel",
            "human_investigation"
          ]
        },
        "family_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "input_shape": {
          "enum": ["ABSTRACT_TABULAR_ROW", "ABSTRACT_DOCUMENT_FRAGMENT"]
        },
        "input_schema_id": {"type": "string", "minLength": 1},
        "input_provenance": {"$ref": "#/$defs/inputProvenance"},
        "field_mappings": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/fieldMapping"}
        },
        "entity_binding": {"$ref": "#/$defs/entityBinding"},
        "projected_claim_envelope": {
          "$ref": "#/$defs/projectedClaimEnvelope"
        }
      }
    }
  }
}
