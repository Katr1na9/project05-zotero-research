{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-b4-manifest.schema.json",
  "title": "Project05 Part B B4 authority manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "status",
    "authorized_slice",
    "execution_authority",
    "sampling_authority",
    "planner_authority",
    "scalarization_authority",
    "performance_claim_authority",
    "stop_authority",
    "bindings",
    "closed_slices",
    "llm_integration",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "manifest_id": {"const": "part-b-b4-manifest-v0.8"},
    "manifest_version": {"const": "0.8.0"},
    "status": {"const": "B4_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B4_BASELINE_PREREG"},
    "execution_authority": {"const": false},
    "sampling_authority": {"const": false},
    "planner_authority": {"const": false},
    "scalarization_authority": {"const": false},
    "performance_claim_authority": {"const": false},
    "stop_authority": {"const": "NONE"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b2_manifest_hash",
        "pb_si_003_decision_hash",
        "b3_cost_instrumentation_policy_hash",
        "b3_manifest_hash",
        "baseline_preregistration_hash",
        "baseline_isolation_policy_hash"
      ],
      "properties": {
        "b2_manifest_hash": {"$ref": "#/$defs/sha256"},
        "pb_si_003_decision_hash": {"$ref": "#/$defs/sha256"},
        "b3_cost_instrumentation_policy_hash": {"$ref": "#/$defs/sha256"},
        "b3_manifest_hash": {"$ref": "#/$defs/sha256"},
        "baseline_preregistration_hash": {"$ref": "#/$defs/sha256"},
        "baseline_isolation_policy_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "closed_slices": {
      "type": "array",
      "prefixItems": [
        {"const": "B5"},
        {"const": "B6"},
        {"const": "B7"},
        {"const": "B8"},
        {"const": "B9"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "llm_integration": {"const": "FORBIDDEN"},
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
