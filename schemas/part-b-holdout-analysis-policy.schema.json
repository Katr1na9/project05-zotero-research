        "holdout_visible_before_final_freeze": {"const": false},
        "evaluation_feedback_to_training": {"const": false},
        "holdout_feedback_to_train": {"const": false},
        "holdout_feedback_to_tune": {"const": false},
        "holdout_feedback_to_evaluation": {"const": false},
        "holdout_feedback_to_planner": {"const": false},
        "holdout_feedback_to_any_model": {"const": false},
        "post_holdout_model_update": {"const": false},
        "contract_unseals_holdout": {"const": false}
