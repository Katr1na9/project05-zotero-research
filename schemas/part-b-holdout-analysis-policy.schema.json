    "runtime_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_data_access",
        "holdout_label_access",
        "holdout_result_access",
        "statistical_analysis_execution",
        "network_access",
        "connector_execution",
        "data_retrieval",
        "data_download",
        "sampling",
        "planner_execution",
        "evaluation_execution"
      ],
      "properties": {
        "holdout_data_access": {"const": false},
        "holdout_label_access": {"const": false},
        "holdout_result_access": {"const": false},
        "statistical_analysis_execution": {"const": false},
        "network_access": {"const": false},
        "connector_execution": {"const": false},
        "data_retrieval": {"const": false},
        "data_download": {"const": false},
        "sampling": {"const": false},
        "planner_execution": {"const": false},
        "evaluation_execution": {"const": false}
      }
    },
    "access_boundary": {"$ref": "#/$defs/accessBoundary"},
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_consistency_only",
        "holdout_split_validated",
        "source_validated",
        "analysis_executed",
        "external_validity",
        "performance_validity",
        "superiority_claim"
      ],
      "properties": {
        "contract_consistency_only": {"const": true},
        "holdout_split_validated": {"const": false},
        "source_validated": {"const": false},
        "analysis_executed": {"const": false},
        "external_validity": {"const": false},
        "performance_validity": {"const": false},
        "superiority_claim": {"const": false}
      }
    },
    "limitations": {"$ref": "#/$defs/limitations"},
    "hash": {
      "const": "sha256:542ed51380c7dc3e5ba1553d3c80b1a55e5ca5b008cb38d3df831fdee828b603"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "upstreamBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b1_federation_contract_hash",
        "b1_adapter_conformance_hash",
        "b1_manifest_hash",
        "b2_stochastic_catalog_hash",
        "b2_tv_policy_hash",
        "b2_world_pair_delta_decision_hash",
        "b2_manifest_hash",
        "b3_cost_instrumentation_policy_hash",
        "b3_manifest_hash",
        "b4_baseline_preregistration_hash",
        "b4_baseline_isolation_policy_hash",
        "b4_manifest_hash",
        "b5_planner_public_state_example_hash",
        "b5_planner_decision_example_hash",
        "b5_planner_interface_policy_hash",
        "b5_bounded_evaluation_hash",
        "b5_manifest_hash",
        "b6_closed_loop_policy_hash",
