        "pb_si_006_state": {"const": "OPEN"},
        "real_source_selected": {"const": false},
        "real_source_authorized": {"const": false},
        "per_source_authorization_required": {"const": true},
        "abstract_contract_fixture_only": {"const": true}
      }
    },
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_outcome",
        "timeout",
        "resource_exhaustion",
        "infeasible",
        "partial_result",
        "analysis_not_executed",
        "holdout_access_denied"
      ],
      "properties": {
        "missing_outcome": {"const": "UNKNOWN_NO_RANK"},
        "timeout": {"const": "UNKNOWN_NO_RANK"},
        "resource_exhaustion": {"const": "UNKNOWN_NO_RANK"},
        "infeasible": {"const": "SEPARATE_NO_RANK"},
        "partial_result": {"const": "UNKNOWN_INCOMPLETE_NO_RANK"},
        "analysis_not_executed": {"const": "CONTRACT_ONLY_NO_RESULT"},
        "holdout_access_denied": {"const": "DENY_NO_ACCESS"}
