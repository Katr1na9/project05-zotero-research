      "additionalProperties": false,
      "required": [
        "default_decision",
        "required_conditions",
        "failure_behavior",
        "contract_only_no_release"
      ],
      "properties": {
        "default_decision": {"const": "DENY"},
        "required_conditions": {
          "const": [
            "B4_REGISTRY_FROZEN",
            "B4_ISOLATION_BOUND",
            "SPLIT_COMMITMENT_FROZEN",
            "PER_SOURCE_AUTHORIZATION_APPROVED",
            "ANALYSIS_PLAN_FROZEN",
            "SEPARATE_EXECUTION_AUTHORIZATION_APPROVED"
          ]
        },
        "failure_behavior": {"const": "FAIL_CLOSED_NO_ACCESS"},
        "contract_only_no_release": {"const": true}
      }
    },
    "partition_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b4_isolation_policy_hash",
        "partition_order",
        "active_partition",
        "mutually_disjoint",
        "holdout_visible_before_final_freeze",
