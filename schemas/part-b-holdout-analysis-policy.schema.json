        "holdout_data_loaded": {"const": false},
        "holdout_labels_loaded": {"const": false},
        "holdout_results_loaded": {"const": false},
        "statistics_computed": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
