{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-closed-loop-episode.schema.json",
  "title": "Project05 Part B B6 closed-loop episode example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "episode_version",
    "status",
    "authorized_slice",
    "case_id",
    "partition",
    "policy_hash",
    "preregistration_hash",
    "finite_step_count",
    "sequence",
    "steps",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "episode_id": {"const": "part-b-closed-loop-episode-example-v0.8"},
    "episode_version": {"const": "0.8.0"},
    "status": {"const": "B6_CONTRACT_EXAMPLE_ONLY"},
    "authorized_slice": {"const": "B6_CLOSED_LOOP_EVAL"},
    "case_id": {"$ref": "#/$defs/publicId"},
    "partition": {"enum": ["TRAIN", "TUNE", "EVALUATION", "HOLDOUT"]},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "preregistration_hash": {"$ref": "#/$defs/sha256"},
    "finite_step_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "sequence": {
      "const": [
        "PUBLIC_STATE_REFERENCE",
        "ACTION_ID_DECISION_REFERENCE",
        "FEEDBACK_ENVELOPE_REFERENCE"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/step"}
    },
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publicId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "idList": {
      "type": "array",
      "items": {"$ref": "#/$defs/publicId"},
      "uniqueItems": true,
      "minItems": 1
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_index",
        "public_state_reference",
        "decision_reference",
        "feedback_reference"
      ],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0},
        "public_state_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_id",
            "public_state_hash",
            "feasible_action_ids"
          ],
          "properties": {
            "state_id": {"$ref": "#/$defs/publicId"},
            "public_state_hash": {"$ref": "#/$defs/sha256"},
            "feasible_action_ids": {"$ref": "#/$defs/idList"}
          }
        },
        "decision_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_id",
            "decision_hash",
            "public_state_hash",
            "decision_status",
            "selected_action_id"
          ],
          "properties": {
            "decision_id": {"$ref": "#/$defs/publicId"},
            "decision_hash": {"$ref": "#/$defs/sha256"},
            "public_state_hash": {"$ref": "#/$defs/sha256"},
            "decision_status": {"enum": ["SELECT_ACTION", "NO_ACTION"]},
            "selected_action_id": {
              "anyOf": [
                {"$ref": "#/$defs/publicId"},
                {"type": "null"}
              ]
            }
          }
        },
        "feedback_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feedback_id", "feedback_hash"],
          "properties": {
            "feedback_id": {"$ref": "#/$defs/publicId"},
            "feedback_hash": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
