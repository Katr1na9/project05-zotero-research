{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-b2-world-pair-delta-decision.schema.json",
  "title": "Project05 Part B PB-SI-003 world-pair and delta decision",
  "description": "Decision-rule contract only. It closes exact finite world-pair/delta semantics without granting execution or sampling authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_version",
    "status",
    "authorized_slice",
    "decision_rule_authority",
    "execution_authority",
    "sampling_authority",
    "stop_authority",
    "applies_to",
    "pb_si_003_state",
    "bindings",
    "world_pair_policy",
    "delta_policy",
    "multi_pair_rule",
    "model_boundary",
    "conformance_example",
    "error_semantics",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "decision_id": {
      "const": "part-b-b2-world-pair-delta-decision-v0.8"
    },
    "decision_version": {"const": "0.8.0"},
    "status": {"const": "APPROVED_DECISION_CONTRACT_ONLY"},
    "authorized_slice": {
      "const": "B2_SI003_WORLD_PAIR_DELTA_DECISION_ONLY"
    },
    "decision_rule_authority": {"const": true},
    "execution_authority": {"const": false},
    "sampling_authority": {"const": false},
    "stop_authority": {"const": "NONE"},
    "applies_to": {"const": "EXACT_FINITE_TABLES_ONLY"},
    "pb_si_003_state": {
      "const": "CLOSED_APPROVED_EXACT_FINITE_ONLY"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b2_catalog_hash",
        "b2_tv_policy_hash",
        "b2_manifest_hash"
      ],
      "properties": {
        "b2_catalog_hash": {"$ref": "#/$defs/sha256"},
        "b2_tv_policy_hash": {"$ref": "#/$defs/sha256"},
        "b2_manifest_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "world_pair_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "support_partition_definition",
        "alternative_partition_definition",
        "single_witness_pair_sufficient",
        "orientation",
        "include_all_cross_partition_pairs",
        "self_pairs_forbidden",
        "duplicates_forbidden",
        "freeze_before_action_outcome",
        "comparison_set_binding",
        "coverage_requirement"
      ],
      "properties": {
        "source": {
          "const": "ALL_LEGAL_WORLDS_PARTITIONED_BY_CANDIDATE_Q"
        },
        "support_partition_definition": {
          "const": "LEGAL_WORLDS_SATISFYING_CANDIDATE_Q"
        },
        "alternative_partition_definition": {
          "const": "LEGAL_WORLDS_SATISFYING_NOT_CANDIDATE_Q"
        },
        "single_witness_pair_sufficient": {"const": false},
        "orientation": {
          "const": "UNORDERED_CANONICAL_LEXICOGRAPHIC"
        },
        "include_all_cross_partition_pairs": {"const": true},
        "self_pairs_forbidden": {"const": true},
        "duplicates_forbidden": {"const": true},
        "freeze_before_action_outcome": {"const": true},
        "comparison_set_binding": {
          "const": "EVALUATION_MANIFEST_HASH_REQUIRED"
        },
        "coverage_requirement": {
          "const": "EVERY_REQUIRED_PAIR_IN_ACTION_FINITE_WORLD_DOMAIN"
        }
      }
    },
    "delta_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "encoding",
        "inclusive_operator",
        "binding",
        "defaults_forbidden",
        "post_hoc_change_forbidden"
      ],
      "properties": {
        "scope": {"const": "PER_ACTION"},
        "encoding": {
          "const": "EXACT_RATIONAL_CLOSED_UNIT_INTERVAL"
        },
        "inclusive_operator": {"const": "GREATER_THAN_OR_EQUAL"},
        "binding": {
          "const": "EXECUTABLE_ACTION_CATALOG_HASH_REQUIRED"
        },
        "defaults_forbidden": {"const": true},
        "post_hoc_change_forbidden": {"const": true}
      }
    },
    "multi_pair_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "pass_condition",
        "empty_pair_set",
        "missing_pair"
      ],
      "properties": {
        "aggregation": {"const": "MINIMUM_TV_WORST_CASE"},
        "pass_condition": {
          "const": "ALL_REQUIRED_PAIRS_GTE_ACTION_DELTA"
        },
        "empty_pair_set": {"const": "NOT_APPLICABLE_FAIL_CLOSED"},
        "missing_pair": {"const": "FAIL_CLOSED_NO_ELIGIBILITY"}
      }
    },
    "model_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_table_decision_defined",
        "estimated_model_acceptance",
        "simulation_reproducibility",
        "executable_catalog_available",
        "closing_this_issue_does_not_authorize_sampler"
      ],
      "properties": {
        "exact_table_decision_defined": {"const": true},
        "estimated_model_acceptance": {
          "const": "UNRESOLVED_PB_B2_SI_003"
        },
        "simulation_reproducibility": {
          "const": "UNRESOLVED_PB_B2_SI_002"
        },
        "executable_catalog_available": {"const": false},
        "closing_this_issue_does_not_authorize_sampler": {"const": true}
      }
    },
    "conformance_example": {"$ref": "#/$defs/conformanceExample"},
    "error_semantics": {"$ref": "#/$defs/errorSemantics"},
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "worldIds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_world_id",
        "right_world_id",
        "total_variation"
      ],
      "properties": {
        "left_world_id": {"type": "string", "minLength": 1},
        "right_world_id": {"type": "string", "minLength": 1},
        "total_variation": {"$ref": "#/$defs/rational"}
      }
    },
    "conformanceExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example_id",
        "result_authority",
        "support_world_ids",
        "alternative_world_ids",
        "required_pairs",
        "action_delta",
        "minimum_tv",
        "decision"
      ],
      "properties": {
        "example_id": {"const": "SI003-EXAMPLE-001"},
        "result_authority": {"const": "CONFORMANCE_CHECK_ONLY"},
        "support_world_ids": {"$ref": "#/$defs/worldIds"},
        "alternative_world_ids": {"$ref": "#/$defs/worldIds"},
        "required_pairs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pair"}
        },
        "action_delta": {"$ref": "#/$defs/rational"},
        "minimum_tv": {"$ref": "#/$defs/rational"},
        "decision": {"const": "ELIGIBLE"}
      }
    },
    "errorSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_set_not_frozen",
        "pair_missing",
        "pair_outside_domain",
        "delta_missing_or_invalid",
        "estimated_model_unapproved",
        "sampling_unauthorized",
        "stop_or_certificate_attempt"
      ],
      "properties": {
        "pair_set_not_frozen": {
          "const": "B2-SI003-001_PAIR_SET_NOT_FROZEN"
        },
        "pair_missing": {"const": "B2-SI003-002_REQUIRED_PAIR_MISSING"},
        "pair_outside_domain": {
          "const": "B2-SI003-003_PAIR_OUTSIDE_FINITE_DOMAIN"
        },
        "delta_missing_or_invalid": {
          "const": "B2-SI003-004_DELTA_MISSING_OR_INVALID"
        },
        "estimated_model_unapproved": {
          "const": "B2-SI003-005_ESTIMATED_MODEL_UNAPPROVED"
        },
        "sampling_unauthorized": {
          "const": "B2-SI003-006_NO_SAMPLING_AUTHORITY"
        },
        "stop_or_certificate_attempt": {
          "const": "B2-SI003-007_NO_STOP_AUTHORITY"
        }
      }
    }
  }
}
