{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-b3-manifest.schema.json",
  "title": "Project05 Part B B3 authority manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "status",
    "authorized_slice",
    "instrumentation_authority",
    "action_execution_authority",
    "sampling_authority",
    "scalarization_authority",
    "performance_claim_authority",
    "stop_authority",
    "bindings",
    "runtime_authority",
    "closed_slices",
    "llm_integration",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "manifest_id": {"const": "part-b-b3-manifest-v0.8"},
    "manifest_version": {"const": "0.8.0"},
    "status": {"const": "B3_LOCAL_REVIEW"},
    "authorized_slice": {"const": "B3_COST_INSTRUMENTATION"},
    "instrumentation_authority": {"const": true},
    "action_execution_authority": {"const": false},
    "sampling_authority": {"const": false},
    "scalarization_authority": {"const": false},
    "performance_claim_authority": {"const": false},
    "stop_authority": {"const": "NONE"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b0_cost_contract_hash",
        "b2_manifest_hash",
        "cost_instrumentation_policy_hash"
      ],
      "properties": {
        "b0_cost_contract_hash": {"$ref": "#/$defs/sha256"},
        "b2_manifest_hash": {"$ref": "#/$defs/sha256"},
        "cost_instrumentation_policy_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_aggregation",
        "clock_capture",
        "executor_hook",
        "external_connector",
        "action_execution",
        "sampling"
      ],
      "properties": {
        "trace_aggregation": {"const": true},
        "clock_capture": {"const": false},
        "executor_hook": {"const": false},
        "external_connector": {"const": false},
        "action_execution": {"const": false},
        "sampling": {"const": false}
      }
    },
    "closed_slices": {
      "type": "array",
      "prefixItems": [
        {"const": "B4"},
        {"const": "B5"},
        {"const": "B6"},
        {"const": "B7"},
        {"const": "B8"},
        {"const": "B9"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "llm_integration": {"const": "FORBIDDEN"},
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
