{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-b5-manifest.schema.json",
  "title": "Project05 Part B B5 authority manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "status",
    "authorized_slice",
    "planner_interface_authority",
    "bounded_evaluation_contract_authority",
    "planner_execution_authority",
    "evaluation_execution_authority",
    "sampling_authority",
    "production_capture_authority",
    "scalarization_authority",
    "performance_claim_authority",
    "stop_authority",
    "bindings",
    "proof_boundary",
    "closed_slices",
    "llm_integration",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "manifest_id": {"const": "part-b-b5-manifest-v0.8"},
    "manifest_version": {"const": "0.8.0"},
    "status": {"const": "B5_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B5_PLANNER_INTERFACE"},
    "planner_interface_authority": {"const": true},
    "bounded_evaluation_contract_authority": {"const": true},
    "planner_execution_authority": {"const": false},
    "evaluation_execution_authority": {"const": false},
    "sampling_authority": {"const": false},
    "production_capture_authority": {"const": false},
    "scalarization_authority": {"const": false},
    "performance_claim_authority": {"const": false},
    "stop_authority": {"const": "NONE"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b4_baseline_preregistration_hash",
        "b4_baseline_isolation_policy_hash",
        "b4_manifest_hash",
        "planner_public_state_example_hash",
        "planner_decision_example_hash",
        "planner_interface_policy_hash",
        "bounded_evaluation_hash"
      ],
      "properties": {
        "b4_baseline_preregistration_hash": {"$ref": "#/$defs/sha256"},
        "b4_baseline_isolation_policy_hash": {"$ref": "#/$defs/sha256"},
        "b4_manifest_hash": {"$ref": "#/$defs/sha256"},
        "planner_public_state_example_hash": {"$ref": "#/$defs/sha256"},
        "planner_decision_example_hash": {"$ref": "#/$defs/sha256"},
        "planner_interface_policy_hash": {"$ref": "#/$defs/sha256"},
        "bounded_evaluation_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_consistency_only",
        "implementation_validation",
        "performance_validity",
        "superiority_claim"
      ],
      "properties": {
        "contract_consistency_only": {"const": true},
        "implementation_validation": {"const": false},
        "performance_validity": {"const": false},
        "superiority_claim": {"const": false}
      }
    },
    "closed_slices": {
      "type": "array",
      "prefixItems": [
        {"const": "B6"},
        {"const": "B7"},
        {"const": "B8"},
        {"const": "B9"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "llm_integration": {"const": "FORBIDDEN"},
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
