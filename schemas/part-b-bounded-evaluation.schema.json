{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-bounded-evaluation.schema.json",
  "title": "Project05 Part B B5 bounded evaluation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "evaluation_version",
    "status",
    "authorized_slice",
    "bound_semantics",
    "bounds",
    "auto_retry",
    "fallback_to_hidden_state",
    "failure_semantics",
    "cost_semantics",
    "allowed_contract_metrics",
    "claim_boundary",
    "isolation_binding",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "evaluation_id": {"const": "part-b-bounded-evaluation-v0.8"},
    "evaluation_version": {"const": "0.8.0"},
    "status": {"const": "B5_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B5_PLANNER_INTERFACE"},
    "bound_semantics": {
      "const": "FINITE_PREDECLARED_CONFORMANCE_ENVELOPE"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_public_state_bytes",
        "max_feasible_action_ids",
        "max_decision_wall_ms",
        "max_decision_cpu_ms",
        "max_memory_bytes",
        "max_decisions_per_case"
      ],
      "properties": {
        "max_public_state_bytes": {"type": "integer", "minimum": 1},
        "max_feasible_action_ids": {"type": "integer", "minimum": 1},
        "max_decision_wall_ms": {"type": "integer", "minimum": 1},
        "max_decision_cpu_ms": {"type": "integer", "minimum": 1},
        "max_memory_bytes": {"type": "integer", "minimum": 1},
        "max_decisions_per_case": {"type": "integer", "minimum": 1}
      }
    },
    "auto_retry": {"const": false},
    "fallback_to_hidden_state": {"const": false},
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout",
        "resource_exhaustion",
        "infeasible",
        "unknown"
      ],
      "properties": {
        "timeout": {"const": "UNKNOWN_NO_RANK"},
        "resource_exhaustion": {"const": "UNKNOWN_NO_RANK"},
        "infeasible": {"const": "SEPARATE_NO_ACTION"},
        "unknown": {"const": "FAIL_CLOSED_NO_RANK"}
      }
    },
    "cost_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b3_cost_instrumentation_policy_hash",
        "representation",
        "scalarization_enabled",
        "infeasible_as_high_cost",
        "missing_measurement"
      ],
      "properties": {
        "b3_cost_instrumentation_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "representation": {"const": "B3_EIGHT_DIMENSION_VECTOR_ONLY"},
        "scalarization_enabled": {"const": false},
        "infeasible_as_high_cost": {"const": false},
        "missing_measurement": {"const": "UNKNOWN_NOT_ZERO"}
      }
    },
    "allowed_contract_metrics": {
      "type": "array",
      "prefixItems": [
        {"const": "INTERFACE_CONFORMANCE"},
        {"const": "FAILURE_CHANNEL_COUNTS"},
        {"const": "UNSCALARIZED_RESOURCE_VECTOR_SHAPE"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_consistency_only",
        "implementation_validation",
        "evaluation_execution_authority",
        "performance_claim_authority",
        "superiority_claim_authority"
      ],
      "properties": {
        "contract_consistency_only": {"const": true},
        "implementation_validation": {"const": false},
        "evaluation_execution_authority": {"const": false},
        "performance_claim_authority": {"const": false},
        "superiority_claim_authority": {"const": false}
      }
    },
    "isolation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b4_baseline_isolation_policy_hash",
        "partitions",
        "evaluation_feedback_to_train",
        "holdout_visible_before_final_freeze",
        "historical_result_access",
        "forbidden_path_prefixes"
      ],
      "properties": {
        "b4_baseline_isolation_policy_hash": {"$ref": "#/$defs/sha256"},
        "partitions": {
          "type": "array",
          "prefixItems": [
            {"const": "TRAIN"},
            {"const": "TUNE"},
            {"const": "EVALUATION"},
            {"const": "HOLDOUT"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "evaluation_feedback_to_train": {"const": false},
        "holdout_visible_before_final_freeze": {"const": false},
        "historical_result_access": {"const": false},
        "forbidden_path_prefixes": {
          "type": "array",
          "prefixItems": [{"const": "09-experiments/"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
