{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/gamma-kernel.schema.json",
  "title": "Project05 v0.8 finite Kernel Scope Contract Gamma",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gamma_id",
    "gamma_version",
    "entity_types",
    "event_types",
    "relation_types",
    "attribution_levels",
    "result_domains",
    "mechanism_rules",
    "temporal_constraints",
    "sensor_coverage",
    "retention_assumptions",
    "missingness_assumptions",
    "threat_assumptions",
    "admission_policy",
    "promotion_policy",
    "action_catalog",
    "candidate_protocol",
    "min_diff",
    "solver_semantics",
    "closed_world_fields",
    "open_world_fields",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "gamma_id": {"type": "string", "minLength": 1},
    "gamma_version": {"type": "string", "pattern": "^0\\.8\\.[0-9]+$"},
    "entity_types": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "event_types": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "relation_types": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "attribution_levels": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "result_domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/resultDomain"}
    },
    "mechanism_rules": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "temporal_constraints": {"type": "object"},
    "sensor_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sensorCoverage"}
    },
    "retention_assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedAssumption"}
    },
    "missingness_assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedAssumption"}
    },
    "threat_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_deletion", "log_forgery", "sensor_compromise"],
      "properties": {
        "log_deletion": {"enum": ["none", "bounded", "unmodeled"]},
        "log_forgery": {"enum": ["none", "bounded", "unmodeled"]},
        "sensor_compromise": {"enum": ["none", "bounded", "unmodeled"]}
      }
    },
    "admission_policy": {"$ref": "#/$defs/policyRef"},
    "promotion_policy": {"$ref": "#/$defs/policyRef"},
    "action_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "actions"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "actions": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "candidate_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposer_ids", "solver_seed_enabled", "coverage_reporting_required"],
      "properties": {
        "proposer_ids": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "solver_seed_enabled": {"type": "boolean"},
        "coverage_reporting_required": {"const": true}
      }
    },
    "min_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_version", "lambda_event", "lambda_entity", "lambda_assumption", "tie_break", "timeout_ms"],
      "properties": {
        "config_version": {"type": "string", "minLength": 1},
        "lambda_event": {"type": "number", "minimum": 0},
        "lambda_entity": {"type": "number", "minimum": 0},
        "lambda_assumption": {"type": "number", "minimum": 0},
        "tie_break": {"const": "lexicographic"},
        "timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "solver_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "timeout_ms", "incomplete_search_policy", "proof_policy"],
      "properties": {
        "engine": {"enum": ["finite_domain_enumerator", "small_csp"]},
        "engine_version": {"type": "string", "minLength": 1},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "incomplete_search_policy": {"const": "UNKNOWN_NOT_CERTIFIED"},
        "proof_policy": {"enum": ["reproducible_run", "solver_proof", "independently_checked"]}
      }
    },
    "closed_world_fields": {"$ref": "#/$defs/uniqueStrings"},
    "open_world_fields": {"$ref": "#/$defs/uniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uniqueStrings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "resultDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "generator", "finite_candidates", "coverage_mode", "finiteness_basis"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "generator": {"enum": ["from_case_entities", "from_finite_candidate_list"]},
        "finite_candidates": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyUniqueStrings"}
          ]
        },
        "coverage_mode": {"enum": ["exhaustive", "solver_complete"]},
        "finiteness_basis": {"enum": ["finite_case_entity_closure", "explicit_finite_candidates"]}
      },
      "allOf": [
        {
          "if": {"properties": {"generator": {"const": "from_case_entities"}}, "required": ["generator"]},
          "then": {
            "properties": {
              "finite_candidates": {"type": "null"},
              "finiteness_basis": {"const": "finite_case_entity_closure"}
            }
          },
          "else": {
            "properties": {
              "finite_candidates": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
              "finiteness_basis": {"const": "explicit_finite_candidates"}
            }
          }
        }
      ]
    },
    "sensorCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_id", "observable_id", "entities", "time_windows", "absence_semantics", "completeness_conditions"],
      "properties": {
        "sensor_id": {"type": "string", "minLength": 1},
        "observable_id": {"type": "string", "minLength": 1},
        "entities": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "time_windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "uniqueItems": true
        },
        "absence_semantics": {"enum": ["closed_world", "open_world", "bounded_completeness", "unknown"]},
        "completeness_conditions": {"$ref": "#/$defs/uniqueStrings"}
      },
      "allOf": [
        {
          "if": {"properties": {"absence_semantics": {"const": "bounded_completeness"}}, "required": ["absence_semantics"]},
          "then": {"properties": {"completeness_conditions": {"minItems": 1}}}
        }
      ]
    },
    "namedAssumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "statement"],
      "properties": {
        "assumption_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rules"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "rules": {"$ref": "#/$defs/uniqueStrings"}
      }
    }
  }
}
