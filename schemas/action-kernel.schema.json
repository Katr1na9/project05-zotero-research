{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/action-kernel.schema.json",
  "title": "Project05 v0.8 deterministic Kernel Action Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "actions", "hash"],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "catalog_id": {"type": "string", "minLength": 1},
    "catalog_version": {"type": "string", "pattern": "^0\\.8\\.[0-9]+$"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/action"}
    },
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "observationModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_id",
        "output_schema",
        "projection_rule_id",
        "noise_model",
        "output_domain",
        "absence_semantics_ref",
        "world_dependencies"
      ],
      "properties": {
        "observable_id": {"type": "string", "minLength": 1},
        "output_schema": {"type": "string", "minLength": 1},
        "projection_rule_id": {"type": "string", "minLength": 1},
        "noise_model": {"const": "deterministic"},
        "output_domain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": ["string", "number", "integer", "boolean", "null"]},
          "uniqueItems": true
        },
        "absence_semantics_ref": {"type": "string", "minLength": 1},
        "world_dependencies": {"$ref": "#/$defs/stringArray"}
      }
    },
    "parameterValue": {
      "oneOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {
          "type": "array",
          "items": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "actor",
        "authority",
        "target",
        "scope",
        "preconditions",
        "invocation",
        "termination",
        "observation_model",
        "formal_analysis_eligibility",
        "state_effect",
        "feasibility",
        "resource_instrumentation"
      ],
      "properties": {
        "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
        "actor": {"enum": ["automated_tool", "analyst", "external_service"]},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_permissions", "current_status"],
          "properties": {
            "required_permissions": {"$ref": "#/$defs/stringArray"},
            "current_status": {"enum": ["executable", "not_authorized", "temporarily_unavailable"]}
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_ids", "entity_type"],
          "properties": {
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "entity_type": {"type": "string", "minLength": 1}
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time_window", "spatial_scope", "resolution"],
          "properties": {
            "time_window": {"$ref": "#/$defs/timeWindow"},
            "spatial_scope": {"type": "string", "minLength": 1},
            "resolution": {"type": "string", "minLength": 1}
          }
        },
        "preconditions": {"$ref": "#/$defs/stringArray"},
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executor_id", "query_template_id", "parameters"],
          "properties": {
            "executor_id": {"type": "string", "minLength": 1},
            "query_template_id": {"type": "string", "minLength": 1},
            "parameters": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "enum": ["ground_truth", "recoverable_claim_ids", "oracle_effects", "hidden_claim_ids", "true_outcome"]
                }
              },
              "additionalProperties": {"$ref": "#/$defs/parameterValue"}
            }
          }
        },
        "termination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_seconds", "success_conditions", "failure_conditions"],
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "success_conditions": {"$ref": "#/$defs/stringArray"},
            "failure_conditions": {"$ref": "#/$defs/stringArray"}
          }
        },
        "observation_model": {
          "oneOf": [
            {"$ref": "#/$defs/observationModel"},
            {"type": "null"}
          ]
        },
        "formal_analysis_eligibility": {"enum": ["formal", "heuristic_only"]},
        "state_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_template_ids", "world_elimination_rule_ids"],
          "properties": {
            "claim_template_ids": {"$ref": "#/$defs/stringArray"},
            "world_elimination_rule_ids": {"$ref": "#/$defs/stringArray"}
          }
        },
        "feasibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_codes"],
          "properties": {
            "status": {
              "enum": ["executable", "not_authorized", "temporarily_unavailable", "retention_expired", "sensor_unavailable"]
            },
            "reason_codes": {"$ref": "#/$defs/stringArray"}
          }
        },
        "resource_instrumentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "cpu_seconds", "bytes_scanned", "records_scanned", "analyst_seconds"],
          "properties": {
            "wall_seconds": {"const": true},
            "cpu_seconds": {"type": "boolean"},
            "bytes_scanned": {"const": true},
            "records_scanned": {"const": true},
            "analyst_seconds": {"type": "boolean"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"observation_model": {"type": "null"}},
            "required": ["observation_model"]
          },
          "then": {"properties": {"formal_analysis_eligibility": {"const": "heuristic_only"}}},
          "else": {"properties": {"formal_analysis_eligibility": {"const": "formal"}}}
        }
      ]
    }
  }
}
