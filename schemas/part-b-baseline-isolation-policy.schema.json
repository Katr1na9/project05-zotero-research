{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-baseline-isolation-policy.schema.json",
  "title": "Project05 Part B B4 baseline isolation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "status",
    "authorized_slice",
    "execution_authority",
    "sampling_authority",
    "planner_authority",
    "performance_claim_authority",
    "partition_order",
    "partitions",
    "isolation",
    "registration_freeze",
    "historical_artifacts",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "policy_id": {"const": "part-b-baseline-isolation-policy-v0.8"},
    "policy_version": {"const": "0.8.0"},
    "status": {"const": "B4_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B4_BASELINE_PREREG"},
    "execution_authority": {"const": false},
    "sampling_authority": {"const": false},
    "planner_authority": {"const": false},
    "performance_claim_authority": {"const": false},
    "partition_order": {
      "type": "array",
      "prefixItems": [
        {"const": "TRAIN"},
        {"const": "TUNE"},
        {"const": "EVALUATION"},
        {"const": "HOLDOUT"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "partitions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/partition"},
      "uniqueItems": true
    },
    "isolation": {"$ref": "#/$defs/isolation"},
    "registration_freeze": {"$ref": "#/$defs/registrationFreeze"},
    "historical_artifacts": {"$ref": "#/$defs/historicalArtifacts"},
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_id",
        "purpose",
        "baseline_read_access",
        "outcome_release"
      ],
      "properties": {
        "partition_id": {
          "enum": ["TRAIN", "TUNE", "EVALUATION", "HOLDOUT"]
        },
        "purpose": {"type": "string", "minLength": 1},
        "baseline_read_access": {
          "enum": [
            "TRAINING_ONLY",
            "TUNING_ONLY",
            "PUBLIC_STATE_ONLY",
            "SEALED_UNTIL_FINAL_ANALYSIS"
          ]
        },
        "outcome_release": {
          "enum": [
            "TRAINING_PIPELINE_ONLY",
            "TUNING_PIPELINE_ONLY",
            "AFTER_REGISTRY_FREEZE",
            "AFTER_FINAL_FREEZE"
          ]
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutually_disjoint",
        "holdout_visible_before_final_freeze",
        "evaluation_outcomes_flow_to_training",
        "holdout_outcomes_flow_to_any_model"
      ],
      "properties": {
        "mutually_disjoint": {"const": true},
        "holdout_visible_before_final_freeze": {"const": false},
        "evaluation_outcomes_flow_to_training": {"const": false},
        "holdout_outcomes_flow_to_any_model": {"const": false}
      }
    },
    "registrationFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_precede_evaluation",
        "roster_mutation_after_first_outcome",
        "parameter_mutation_after_first_outcome",
        "endpoint_mutation_after_first_outcome",
        "seed_mutation_after_first_outcome",
        "tie_break_mutation_after_first_outcome"
      ],
      "properties": {
        "must_precede_evaluation": {"const": true},
        "roster_mutation_after_first_outcome": {"const": false},
        "parameter_mutation_after_first_outcome": {"const": false},
        "endpoint_mutation_after_first_outcome": {"const": false},
        "seed_mutation_after_first_outcome": {"const": false},
        "tie_break_mutation_after_first_outcome": {"const": false}
      }
    },
    "historicalArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_supply_registration_parameters",
        "forbidden_path_prefixes",
        "prohibited_material",
        "violation_behavior"
      ],
      "properties": {
        "may_supply_registration_parameters": {"const": false},
        "forbidden_path_prefixes": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "prohibited_material": {
          "type": "array",
          "minItems": 4,
          "items": {
            "enum": [
              "HISTORICAL_RESULT",
              "REALIZED_ACTION_OUTCOME",
              "HOLDOUT_LABEL",
              "ORACLE_WORLD_ID"
            ]
          },
          "uniqueItems": true
        },
        "violation_behavior": {
          "const": "FAIL_CLOSED_REGISTRATION_REJECTED"
        }
      }
    }
  }
}
