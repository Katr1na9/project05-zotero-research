{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-connector-contract-policy.schema.json",
  "title": "Project05 Part B B7 connector contract policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "status",
    "authorized_slice",
    "bindings",
    "connector_contract",
    "source_authorization",
    "provenance_rules",
    "world_semantics",
    "error_semantics",
    "failure_semantics",
    "runtime_boundary",
    "authority_boundary",
    "proof_boundary",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "policy_id": {"const": "part-b-connector-contract-policy-v0.8"},
    "policy_version": {"const": "0.8.0"},
    "status": {"const": "B7_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B7_BROAD_CONNECTORS"},
    "bindings": {"$ref": "#/$defs/upstreamBindings"},
    "connector_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_kinds",
        "descriptor_semantics",
        "source_identity_semantics"
      ],
      "properties": {
        "connector_kinds": {
          "const": [
            "SNAPSHOT_TABULAR",
            "SNAPSHOT_DOCUMENT",
            "SNAPSHOT_GRAPH",
            "SNAPSHOT_EVENT_STREAM"
          ]
        },
        "descriptor_semantics": {
          "const": "NON_EXECUTABLE_CAPABILITY_DECLARATION"
        },
        "source_identity_semantics": {"const": "ABSTRACT_FIXTURE_ONLY"}
      }
    },
    "source_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_decision",
        "grant_mode",
        "missing_artifact_behavior",
        "descriptor_is_authorization"
      ],
      "properties": {
        "default_decision": {"const": "DENY"},
        "grant_mode": {"const": "SEPARATE_PER_SOURCE_ARTIFACT"},
        "missing_artifact_behavior": {"const": "DENY_NO_ACCESS"},
        "descriptor_is_authorization": {"const": false}
      }
    },
    "provenance_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_provenance",
        "range_semantics",
        "modality_rewrite",
        "authority_self_grant"
      ],
      "properties": {
        "pointer_provenance": {"const": "PRESERVE_EXACTLY"},
        "range_semantics": {
          "const": "EXPLICIT_CONFORMANCE_ENVELOPE_ONLY"
        },
        "modality_rewrite": {"const": "FORBIDDEN"},
        "authority_self_grant": {"const": "FORBIDDEN"}
      }
    },
    "world_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_world_zero_hit", "closed_world_gate"],
      "properties": {
        "open_world_zero_hit": {"const": "UNKNOWN_NOT_ABSENCE"},
        "closed_world_gate": {
          "const": "SEPARATE_COMPLETENESS_ATTESTATION_REQUIRED"
        }
      }
    },
    "error_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_family",
        "unknown_source_schema",
        "conformance_hash_mismatch",
        "source_authorization_missing",
        "source_authorization_mismatch",
        "pointer_rewrite",
        "range_semantics_missing",
        "authority_self_grant"
      ],
      "properties": {
        "unknown_family": {"const": "B7-CONN-001_UNKNOWN_FAMILY"},
        "unknown_source_schema": {
          "const": "B7-CONN-002_UNKNOWN_SOURCE_SCHEMA"
        },
        "conformance_hash_mismatch": {
          "const": "B7-CONN-003_CONFORMANCE_HASH_MISMATCH"
        },
        "source_authorization_missing": {
          "const": "B7-SOURCE-001_SEPARATE_AUTHORIZATION_REQUIRED"
        },
        "source_authorization_mismatch": {
          "const": "B7-SOURCE-002_AUTHORIZATION_BINDING_MISMATCH"
        },
        "pointer_rewrite": {"const": "B7-PROV-001_POINTER_REWRITE"},
        "range_semantics_missing": {
          "const": "B7-PROV-002_RANGE_SEMANTICS_MISSING"
        },
        "authority_self_grant": {
          "const": "B7-PROV-003_AUTHORITY_SELF_GRANT"
        }
      }
    },
    "failure_semantics": {"$ref": "#/$defs/failureSemantics"},
    "runtime_boundary": {"$ref": "#/$defs/runtimeBoundary"},
    "authority_boundary": {"$ref": "#/$defs/authorityBoundary"},
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_consistency_only",
        "source_conformance_validated",
        "connector_implementation_validated",
        "external_validity",
        "performance_validity"
      ],
      "properties": {
        "contract_consistency_only": {"const": true},
        "source_conformance_validated": {"const": false},
        "connector_implementation_validated": {"const": false},
        "external_validity": {"const": false},
        "performance_validity": {"const": false}
      }
    },
    "hash": {"const": "sha256:43c6270078e03ac1764d16c41871a97a09df3a626c060ceebdecc06682b064c3"}
  },
