        "resource_exhaustion",
        "partial_result",
        "parse_failure",
        "schema_mismatch",
        "authorization_missing",
        "connector_unavailable"
      ],
      "properties": {
        "timeout": {"const": "UNKNOWN_NO_ZERO_HIT"},
        "resource_exhaustion": {"const": "UNKNOWN_NO_ZERO_HIT"},
