{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-source-authorization.schema.json",
  "title": "Project05 Part B B7 deny-only source-authorization example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_version",
    "status",
    "authorized_slice",
    "source_id",
    "source_kind",
    "decision",
    "reason_code",
    "bindings",
    "authorization_scope",
    "authorities",
    "execution_boundary",
    "hash"
