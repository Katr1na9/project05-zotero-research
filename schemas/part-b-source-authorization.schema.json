    "source_kind": {"const": "CONTRACT_FIXTURE"},
    "decision": {"const": "NOT_AUTHORIZED"},
    "reason_code": {
      "const": "B7-SOURCE-001_SEPARATE_AUTHORIZATION_REQUIRED"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_hash", "descriptor_hash"],
      "properties": {
        "policy_hash": {
          "const": "sha256:43c6270078e03ac1764d16c41871a97a09df3a626c060ceebdecc06682b064c3"
        },
        "descriptor_hash": {
          "const": "sha256:bc3f2934eb65868ba5db3ac8a0d8bbff7d766271eece9094c68183ce8919ac22"
        }
      }
    },
    "authorization_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ids", "operations"],
      "properties": {
        "dataset_ids": {"type": "array", "maxItems": 0},
        "operations": {"type": "array", "maxItems": 0}
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_access",
        "credential_use",
        "retrieval",
        "download",
        "connector_execution"
