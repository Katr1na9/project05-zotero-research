      "properties": {
        "source_access": {"const": false},
        "credential_use": {"const": false},
        "retrieval": {"const": false},
        "download": {"const": false},
        "connector_execution": {"const": false}
      }
    },
    "execution_boundary": {"$ref": "#/$defs/executionBoundary"},
    "hash": {
      "const": "sha256:6576f01963ed07f291a19c8ddcf60dbc9ab5fcde5c7868671b43107db3ca15e0"
    }
  },
  "$defs": {
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_access",
        "credential_use",
        "retrieval",
        "download",
        "connector_execution"
      ],
      "properties": {
        "network_access": {"const": false},
        "credential_use": {"const": false},
        "retrieval": {"const": false},
        "download": {"const": false},
        "connector_execution": {"const": false}
      }
    }
  }
