{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/formal-ceiling.schema.json",
  "title": "Project05 v0.8 Verified Formal Ceiling Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ceiling_id", "status", "reason_code", "gamma_hash",
    "catalog_hash", "compilation_profile", "target_level", "result_candidates",
    "variable_domains", "cartesian_assignment_bound", "legal_world_count",
    "legal_worlds_hash", "formal_action_ids", "deterministic_observable_ids",
    "excluded_action_reasons", "guarantees", "limitations", "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "ceiling_id": {"type": "string", "minLength": 1},
    "status": {"const": "VERIFIED"},
    "reason_code": {"const": "CEILING-000_EXHAUSTIVE_FINITE_DOMAIN_VERIFIED"},
    "gamma_hash": {"$ref": "#/$defs/sha256"},
    "catalog_hash": {"$ref": "#/$defs/sha256"},
    "compilation_profile": {"type": "string", "minLength": 1},
    "target_level": {"type": "string", "minLength": 1},
    "result_candidates": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "variable_domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
    },
    "cartesian_assignment_bound": {"type": "integer", "minimum": 1},
    "legal_world_count": {"type": "integer", "minimum": 1},
    "legal_worlds_hash": {"$ref": "#/$defs/sha256"},
    "formal_action_ids": {"$ref": "#/$defs/uniqueStrings"},
    "deterministic_observable_ids": {"$ref": "#/$defs/uniqueStrings"},
    "excluded_action_reasons": {
      "type": "object",
      "additionalProperties": {"enum": ["NO_OBSERVATION_MODEL", "HEURISTIC_ONLY", "NO_WORLD_ELIMINATION_RULE"]}
    },
    "guarantees": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uniqueStrings": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    }
  }
}
