{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-observation-contract.schema.json",
  "title": "Project05 Part B stochastic observation contract draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "status",
    "execution_authority",
    "probability_encoding",
    "finite_domain_required",
    "delta_tv_policy",
    "contract_examples",
    "limitations",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "contract_id": {"const": "part-b-observation-contract-v0.8"},
    "contract_version": {"const": "0.8.0"},
    "status": {"const": "CONTRACT_DRAFT"},
    "execution_authority": {"const": false},
    "probability_encoding": {"const": "EXACT_RATIONAL"},
    "finite_domain_required": {"const": true},
    "delta_tv_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_per_stochastic_action",
        "comparison_operator",
        "catalog_hash_binding_required",
        "post_hoc_change_forbidden"
      ],
      "properties": {
        "required_per_stochastic_action": {"const": true},
        "comparison_operator": {"const": "GREATER_THAN_OR_EQUAL"},
        "catalog_hash_binding_required": {"const": true},
        "post_hoc_change_forbidden": {"const": true}
      }
    },
    "contract_examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/example"}
    },
    "limitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "probabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "probability"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "probability": {"$ref": "#/$defs/rational"}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example_id",
        "not_catalog_action",
        "finite_worlds",
        "finite_outcomes",
        "conditional_distribution",
        "registered_delta_tv"
      ],
      "properties": {
        "example_id": {"type": "string", "minLength": 1},
        "not_catalog_action": {"const": true},
        "finite_worlds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "finite_outcomes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "conditional_distribution": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {"$ref": "#/$defs/probabilityEntry"}
          }
        },
        "registered_delta_tv": {"$ref": "#/$defs/rational"}
      }
    }
  }
}
