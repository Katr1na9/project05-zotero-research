{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/part-b-b2-manifest.schema.json",
  "title": "Project05 Part B B2 stochastic-observation contract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "status",
    "authorized_slice",
    "execution_authority",
    "sampling_authority",
    "pb_si_003_state",
    "llm_integration",
    "stop_authority",
    "closed_slices",
    "bindings",
    "runtime_authority",
    "allowed_outputs",
    "next_gate",
    "hash"
  ],
  "properties": {
    "schema_version": {"const": "0.8.0"},
    "manifest_id": {"const": "part-b-b2-manifest-v0.8"},
    "manifest_version": {"const": "0.8.0"},
    "status": {"const": "B2_CONTRACT_ONLY"},
    "authorized_slice": {"const": "B2_STOCHASTIC_OBSERVATION"},
    "execution_authority": {"const": false},
    "sampling_authority": {"const": false},
    "pb_si_003_state": {"const": "OPEN_BLOCKS_STOCHASTIC_EXECUTION"},
    "llm_integration": {"const": "FORBIDDEN"},
    "stop_authority": {"const": "NONE"},
    "closed_slices": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"const": "B3"},
        {"const": "B4"},
        {"const": "B5"},
        {"const": "B6"},
        {"const": "B7"},
        {"const": "B8"},
        {"const": "B9"}
      ],
      "items": false
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b0_manifest_hash",
        "b1_manifest_hash",
        "stochastic_catalog_hash",
        "tv_policy_hash"
      ],
      "properties": {
        "b0_manifest_hash": {"$ref": "#/$defs/sha256"},
        "b1_manifest_hash": {"$ref": "#/$defs/sha256"},
        "stochastic_catalog_hash": {"$ref": "#/$defs/sha256"},
        "tv_policy_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stochastic_runtime",
        "sampler",
        "simulation_runtime",
        "empirical_model_estimation",
        "federation_runtime",
        "real_connectors",
        "data_downloads",
        "real_data_access",
        "cost_instrumentation",
        "planner",
        "m3star",
        "llm"
      ],
      "properties": {
        "stochastic_runtime": {"const": false},
        "sampler": {"const": false},
        "simulation_runtime": {"const": false},
        "empirical_model_estimation": {"const": false},
        "federation_runtime": {"const": false},
        "real_connectors": {"const": false},
        "data_downloads": {"const": false},
        "real_data_access": {"const": false},
        "cost_instrumentation": {"const": false},
        "planner": {"const": false},
        "m3star": {"const": false},
        "llm": {"const": false}
      }
    },
    "allowed_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "next_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_explicit_user_authorization",
        "requires_pb_si_003_closure_for_execution",
        "default"
      ],
      "properties": {
        "requires_explicit_user_authorization": {"const": true},
        "requires_pb_si_003_closure_for_execution": {"const": true},
        "default": {"const": "STOP_AFTER_B2_REVIEW"}
      }
    },
    "hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
