    "case": {
      "surface_id": "project05_depth2_public",
      "fixture_id": "project05-depth2-public-v0.1",
      "package_id": "pkg_73d77b55ef6a517a0dc528f7f3a89bd9",
      "claim_count": 41,
      "claim_id_list_sha256": "11ef0f4672d9f43357639e46c19b27474ddcdf40daffb9acb93af9c810d008a4",
      "claims_content_hash": "594c0ec4c4533b1fae76ce57579cf52c783e61fc6b191d9807ce9751e5d473f1"
    },
    "hypothesis": "For the single pinned project05_depth2_public fixture, the overall experiment mainline can consume the closed Claim-ID provenance chain read-only without changing planner action selection, without placing clm_* identifiers into case-local E1 or scoring, and without collapsing store, E_case, certificate, CERTIFIED_STOP, or ordinary run_mvp STOP layers.",
    "control_arms": [
      {
        "arm_id": "A_MAINLINE_BASELINE_NO_CLAIM_ID_PROVENANCE",
        "uses_existing_pins_read_only": true,
        "claim_id_provenance_attached": false,
        "operation": "Run the pinned local planner/control-loop fixture without Claim-ID provenance attachment.",
        "expected_action_id": "A-high"
      },
      {
        "arm_id": "B_MAINLINE_CLAIM_ID_PROVENANCE_READ_ONLY",
        "uses_existing_pins_read_only": true,
        "claim_id_provenance_attached": true,
        "operation": "Load and validate the existing durable-replay attachment; do not enable capability or consume a write ledger.",
        "expected_action_id": "A-high",
        "expected_algorithm_changed": false
      },
      {
        "arm_id": "C_MAINLINE_MIXLAYER_NEGATIVE",
        "uses_existing_pins_read_only": true,
        "claim_id_provenance_attached": false,
        "operation": "Classify three prohibited promotions without invoking a write path.",
        "negative_cases": [
          "store_as_e_case",
          "certificate_as_certified_stop",
          "certified_stop_as_run_mvp_ordinary_stop"
        ],
        "expected_decision_for_each": "FAIL_CLOSED_DENY"
      }
    ],
    "read_only_steps": [
      {
        "step_id": "RO-01",
        "operation": "Verify authority_base_commit and all pinned_closed_assets SHA-256 values.",
        "reads_existing_pin_only": true
      },
      {
        "step_id": "RO-02",
        "operation": "Load the effective consumer contract and dual Claim-IR schemas for identity validation.",
        "reads_existing_pin_only": true
      },
      {
        "step_id": "RO-03",
        "operation": "Load intake store, E_case, certificate, and CERTIFIED_STOP fixture records as distinct record classes.",
        "reads_existing_pin_only": true
      },
      {
        "step_id": "RO-04",
        "operation": "Load the Claim-ID control-loop reference and controller/planner wiring receipts.",
        "reads_existing_pin_only": true
      },
      {
        "step_id": "RO-05",
        "operation": "Use load_claim_id_durable_replay_attachment plus validate_durable_replay_attachment only.",
        "reads_existing_pin_only": true
      },
      {
        "step_id": "RO-06",
        "operation": "Snapshot protected bytes before and after any accepted read-only rerun.",
        "reads_existing_pin_only": true
      },
      {
        "step_id": "RO-07",
        "operation": "Record A/B action identity, algorithm_changed=false, Claim-ID isolation, and Arm C fail-closed outcomes without creating authoritative bytes.",
        "reads_existing_pin_only": true
      }
    ],
    "success_criteria": [
      "All pinned_closed_assets match exact repository bytes at authority_base_commit.",
      "Arm A and Arm B both select A-high on the pinned local fixture.",
      "Arm B reports algorithm_changed=false.",
      "No clm_* identifier enters case-local E1 or scoring.",
      "All three Arm C promotions return FAIL_CLOSED_DENY without a write path.",
      "PRODUCTION_REGISTRATION_ENABLED remains False.",
      "Protected bytes are identical before and after.",
      "No new activation or exhausted ledger is consumed.",
      "No L2, Part B, M2, four-family, Checker, sufficiency, certificate, or CERTIFIED_STOP authority is inferred."
    ],
    "failure_criteria": [
