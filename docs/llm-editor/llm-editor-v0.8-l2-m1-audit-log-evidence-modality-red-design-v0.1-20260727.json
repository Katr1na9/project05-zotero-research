  "scientific_reason": {
    "target_question": "Whether a controlled operation or change left a citable public audit declaration, without ingesting or reproducing a raw audit log.",
    "why_needed": "The existing three modalities can describe system events, provenance structure, and external reported intelligence, but none independently declares that an audit mechanism recorded a controlled operation/change with an operation class, target, actor/change/request references, and a source-reported outcome.",
    "relative_to_system_log": "A system log event may be generated by software without representing a governance or control-plane audit record. Audit-log evidence is limited to the public declaration that an audit mechanism recorded a controlled action or change; it does not reuse event/provider/principal fields or evidence.system_log.* claims.",
    "relative_to_provenance_graph": "A provenance graph supplies structural relations and materialization basis; it does not itself state that a controlled operation was recorded by an audit facility or provide an audit-specific reported outcome.",
    "relative_to_cti_report": "A CTI report is an external publication declaration. An audit-log projection is a controlled-domain audit-record declaration and cannot be normalized from CTI citation semantics.",
    "evidence_ceiling": "PUBLIC_AUDIT_DECLARATION_ONLY",
    "not_proven": [
      "that the underlying operation actually occurred",
      "that the public actor reference identifies a real actor",
      "that the actor was authorized",
      "that the source-reported outcome is true",
      "that the declaration is scientifically sufficient",
      "that admission, ingestion, certificate, or STOP is warranted"
    ]
  },
