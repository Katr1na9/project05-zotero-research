  "si_llm_005_response": {
    "issue_pin": {
      "path": "docs/spec-issues/SI-LLM-005-source-modality-mapping.md",
      "sha256": "6cdf468ea141b2bba6684bc0581e733fa8ee6e76ad201f480338706a27473dca"
    },
    "legacy_source_modality_semantics": "Legacy source_modality remains transport or carrier metadata and is never renamed, copied, or treated as epistemic modality.",
    "epistemic_modality_source": "A deterministic declaration from pinned, trusted ingestion metadata under a modality-specific mapping rule.",
    "llm_modality_inference": false,
    "semantic_guessing_from_source_text": false,
    "uncertain_or_untrusted_modality": {
      "modality": "unknown",
      "admission_behavior": "abstain",
      "silent_default": false
    },
    "promotion_invariance": {
      "promotion_changes_modality": false,
      "reported_can_become_observed_by_promotion": false,
      "derived_can_become_observed_by_promotion": false
    },
    "system_log_rule": "Direct source-attested event records may declare observed; aggregations, correlations, detections, or transformed alerts must declare derived; inability to prove either is unknown plus abstain.",
    "provenance_graph_rule": "A projection may declare observed only when every represented node and edge is directly source-attested under the same pinned basis; inferred, correlated, aggregated, or transformed graph elements require derived; mixed or unclear basis must be split or become unknown plus abstain.",
    "cti_report_rule": "CTI report material defaults to reported and cannot be silently normalized, promoted, cited, or transformed into observed endpoint evidence; uncertainty becomes unknown plus abstain.",
    "non_amplification_target": "Prevent evidence laundering and preserve Modality Leakage Rate equals zero as a future testable requirement; this RED design does not claim the target is achieved."
  },
