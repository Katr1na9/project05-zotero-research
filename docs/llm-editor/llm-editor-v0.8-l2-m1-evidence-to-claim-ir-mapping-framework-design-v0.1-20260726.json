  "current_schema_compatibility_finding": {
    "nonempty_evidence_claims_valid_under_current_external_schema": false,
    "nonempty_evidence_claims_valid_under_current_kernel_schema": false,
    "blocking_reasons": [
      "The current claim_kind enum contains only planner public_config, public_alignment_state, public_action_declaration, and public_prospective_effect values.",
      "The current claim_record requires source_field and restricts it to the 38 planner config, state, and action paths.",
      "The current closed claim_record cannot carry evidence_field, source_class, source_record_ref, or epistemic_modality.",
      "The current manifest.field_path_set is restricted to the same planner source_field enum."
    ],
    "fail_closed_conclusion": "No nonempty evidence claim may be emitted under the current effective schemas. Reusing a planner source_field or claim_kind would be identity laundering.",
    "required_future_work": "A separately reviewed additive schema and consumer-contract revision must introduce a discriminated evidence claim-record branch before GREEN-2 runtime mapping can be implemented.",
    "this_design_changes_schema_now": false
  },
  "proposed_evidence_claim_namespace": {
    "record_branch_name": "evidence_claim_record_v0_1",
    "discriminator": {
      "field": "record_class",
      "value": "public_evidence_declaration"
    },
    "evidence_field_pattern": "^evidence\\.(system_log|provenance_graph|cti_report)\\.[a-z0-9_.]+$",
    "planner_source_field_allowed_in_evidence_record": false,
    "planner_allowlisted_source_slot_allowed_in_evidence_record": false,
    "claim_kind_prefix": "evidence.",
    "claim_kind_families": [
      "evidence.system_log.event_identity",
      "evidence.system_log.event_attribute",
      "evidence.system_log.principal_reference",
      "evidence.provenance_graph.graph_identity",
      "evidence.provenance_graph.node_declaration",
      "evidence.provenance_graph.edge_declaration",
      "evidence.provenance_graph.time_boundary",
      "evidence.provenance_graph.summary",
      "evidence.cti_report.report_identity",
      "evidence.cti_report.publisher_declaration",
      "evidence.cti_report.publication_boundary",
      "evidence.cti_report.reported_marker",
      "evidence.cti_report.object_declaration",
      "evidence.cti_report.technique_declaration",
      "evidence.cti_report.relation_declaration"
    ],
    "value_types_reused_as_closed_primitives": [
      "opaque_reference",
      "bounded_number",
      "bounded_boolean",
      "bounded_enum",
      "bounded_public_text"
    ],
    "new_value_type_added_by_this_design": false
  },
  "proposed_evidence_claim_record_shape": {
    "required_fields": [
      "record_class",
      "claim_id",
      "claim_id_state",
      "claim_kind",
      "evidence_field",
      "occurrence_key",
      "value_type",
      "value",
      "source_class",
      "source_record_ref",
      "epistemic_modality",
      "modality_basis_code",
      "trusted_ingestion_metadata_sha256",
      "admission_state"
    ],
    "fixed_fields": {
      "record_class": "public_evidence_declaration",
      "claim_id": null,
      "claim_id_state": "not_minted",
      "admission_state": "not_admitted"
    },
    "identity_contract": {
      "claim_id_is_identity": false,
      "claim_id_minting_occurs": false,
      "design_identity_tuple": [
        "surface_id",
        "source_class",
        "source_record_ref",
        "projection_sha256",
        "claim_kind",
        "evidence_field",
        "occurrence_key",
        "canonical_value_sha256",
        "epistemic_modality",
        "modality_basis_code",
        "trusted_ingestion_metadata_sha256"
      ],
      "tuple_purpose": "Deterministic equality and ordering input for a future reviewed mapper only; it is not a Claim ID, certificate identity, admission identity, or effective mint input.",
      "draft_identity_emission_authorized": false,
      "hmac_or_secret_created": false
    },
    "closed_record_rule": "Unknown fields and missing required fields reject the entire mapping request. No partial claim set is returned."
  },
  "package_state_contract": {
    "schema_version": "future_separately_reviewed_evidence_claim_extension",
    "surface_id": "project05_depth2_public",
    "claim_id_state": "not_minted",
    "admission_state": "not_admitted",
    "kernel_state": "pending_kernel_schema",
    "every_claim_claim_id": null,
    "claims_nonempty_required": true,
    "manifest_claim_count_equals_claims_length": true,
    "legacy_planner_field_path_set": [],
    "future_evidence_field_path_set_required": true,
    "package_id_is_not_minted_claim_id": true,
    "certificate_surface": "vacant"
  },
  "direct_mapping_pipeline": [
    {
      "ordinal": 1,
      "step": "verify_all_authority_projection_schema_and_adapter_pins",
      "read_only": true
    },
    {
      "ordinal": 2,
      "step": "validate_one_exact_source_class_projection_against_its_closed_allowlist",
      "read_only": true
    },
    {
      "ordinal": 3,
      "step": "derive_epistemic_modality_only_from_the_pinned_modality_basis_rule",
      "llm_inference": false
    },
    {
      "ordinal": 4,
      "step": "map_only_contract_listed_scalar_projection_fields_to_the_independent_evidence_namespace",
      "silent_field_drop": false
    },
    {
      "ordinal": 5,
      "step": "sort_claim_drafts_by_contract_ordinal_then_occurrence_key_utf8_bytes",
      "deterministic": true
    },
    {
      "ordinal": 6,
      "step": "validate_nonempty_closed_evidence_claim_record_set_and_fixed_package_states",
      "mint": false,
      "admission": false
    }
  ],
  "modality_carry_contract": {
    "modality_is_per_claim_required_metadata": true,
    "modality_source": "source_metadata.epistemic_modality after exact basis validation",
    "system_log": {
      "DIRECT_SOURCE_ATTESTED_EVENT": "observed",
