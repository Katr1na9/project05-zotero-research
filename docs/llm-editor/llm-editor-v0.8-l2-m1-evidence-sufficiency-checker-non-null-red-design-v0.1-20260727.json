    "$defs": {
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "package_binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "package_role",
          "source_class",
          "epistemic_modality",
          "package_sha256",
          "claim_count",
          "evidence_field_path_set_sha256"
