        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,256}$"
          },
          "package_role": {
            "enum": [
              "E2E_ANCHOR",
              "A1_COVERAGE"
            ]
          },
          "source_class": {
            "enum": [
              "system_log_public_projection",
              "provenance_graph_public_projection",
              "cti_report_public_projection"
            ]
          },
          "epistemic_modality": {
            "enum": [
              "observed",
              "derived",
              "reported"
            ]
          },
          "package_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "claim_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_field_path_set_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_class": {
                  "const": "cti_report_public_projection"
                }
              },
              "required": [
                "source_class"
              ]
            },
            "then": {
              "properties": {
                "epistemic_modality": {
                  "const": "reported"
                }
              }
            },
            "else": {
              "properties": {
                "epistemic_modality": {
                  "enum": [
                    "observed",
                    "derived"
                  ]
                }
              }
            }
          }
        ]
      },
      "rejected_candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_kind",
          "source_class",
          "candidate_projection_sha256",
          "epistemic_modality",
          "reason_code",
