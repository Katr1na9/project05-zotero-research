    {
      "question_id": "M1-EVIDENCE-RED-ORQ-01",
      "question": "Are system_log_public_projection, provenance_graph_public_projection, and cti_report_public_projection sufficient as the minimum evidence-modality set for final experiment delivery, with audit_log_public_projection explicitly OUT_OF_V0_1?"
    },
    {
      "question_id": "M1-EVIDENCE-RED-ORQ-02",
      "question": "Is the CTI boundary acceptable: reported is the strict default, observed and derived are rejected in this source class, uncertainty becomes unknown plus abstain, and promotion or citation never changes modality?"
    },
    {
      "question_id": "M1-EVIDENCE-RED-ORQ-03",
      "question": "Is the hard separation from planner_experiment_inputs and claim_ir_valid_fixture sufficient, with no cross-adapter merge, fallback, or reuse as evidence-modality ingress?"
    },
    {
      "question_id": "M1-EVIDENCE-RED-ORQ-04",
      "question": "Should a future GREEN define an intermediate observation or event IR, or should v0.1 normalize each pinned public projection directly to the existing M0 structural boundary?"
    },
    {
      "question_id": "M1-EVIDENCE-RED-ORQ-05",
      "question": "Are the concrete per-modality field allowlists, denylists, trusted modality-basis declarations, and unknown-field rejection rules sufficient for a later implementation authorization request?"
    }
