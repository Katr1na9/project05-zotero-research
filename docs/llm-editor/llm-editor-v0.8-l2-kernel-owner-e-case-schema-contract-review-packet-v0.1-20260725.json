  "review_summary": {
    "proposed_schema_summary": "Define a new provenance-only E_case record with its own e_case_id and type flags, exact source-store pins, 41 opaque Claim-ID references, effective artifact provenance, single-use write authority, transaction identity, and explicit false Checker/certificate/CERTIFIED_STOP assertions.",
    "proposed_mapping_summary": "Construct a new target; preserve the intake record and receipt byte-for-byte; copy only package identity, source states, aggregate hashes, and Claim-ID identity references; never copy claim values, labels, outcomes, or oracle fields.",
    "proposed_transaction_summary": "Validate all effective owner pins and source bytes before mutation; one atomic target; deterministic transaction and idempotency identities; target empty or exactly idempotent; process start consumes the single attempt; no retry/resume/fallback.",
    "hard_boundary": "E_case write is not Kernel intake, Checker acceptance, evidence sufficiency, promotion, certificate generation, CERTIFIED_STOP, SI-LLM-001 closure, L2, or Part B elevation."
  },
