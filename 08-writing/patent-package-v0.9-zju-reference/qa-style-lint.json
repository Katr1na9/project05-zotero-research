      {
        "para_index": 2,
        "text": "\u672c\u53d1\u660e\u516c\u5f00\u4e00\u79cd\u9762\u5411\u4e0d\u5b8c\u6574\u5b89\u5168\u8bc1\u636e\u7684\u8c03\u67e5\u53d6\u8bc1\u52a8\u4f5c\u89c4\u5212\u65b9\u6cd5\u3002\u8be5\u65b9\u6cd5\u83b7\u53d6\u653b\u51fb\u884c\u4e3a\u56fe\u53ca\u4e0e\u5176\u90e8\u5206\u5bf9\u9f50\u3001\u80fd\u591f\u56de\u6307\u539f\u59cb\u5b89\u5168\u4e8b\u4ef6\u7684\u5b89\u5168\u8bc1\u636e\u58f0\u660e\uff0c\u6784\u5efa\u5305\u62ec\u672a\u5339\u914d\u5173\u952e\u884c\u4e3a\u8282\u70b9\u3001\u5f53\u524d\u53ef\u652f\u6491\u8c03\u67e5\u7ed3\u8bba\u7c92\u5ea6\u3001\u5269\u4f59\u53d6\u8bc1\u9884\u7b97\u548c\u52a8\u4f5c\u53cd\u9988\u7684\u8bc1\u636e\u7f3a\u53e3\u72b6\u6001\uff1b\u83b7\u53d6\u5177\u6709\u9884\u6267\u884c\u516c\u5f00\u76ee\u6807",
        "style": "Normal"
      },
      {
        "para_index": 4,
        "text": "\u6743\u5229\u8981\u6c42\u4e66",
        "style": "Normal"
      },
      {
        "para_index": 5,
        "text": "1. \u4e00\u79cd\u9762\u5411\u4e0d\u5b8c\u6574\u5b89\u5168\u8bc1\u636e\u7684\u8c03\u67e5\u53d6\u8bc1\u52a8\u4f5c\u89c4\u5212\u65b9\u6cd5\uff0c\u5176\u7279\u5f81\u5728\u4e8e\uff0c\u7531\u8ba1\u7b97\u8bbe\u5907\u6267\u884c\uff0c\u5305\u62ec\uff1a\u83b7\u53d6\u653b\u51fb\u884c\u4e3a\u56fe\u4ee5\u53ca\u4e0e\u6240\u8ff0\u653b\u51fb\u884c\u4e3a\u56fe\u90e8\u5206\u5bf9\u9f50\u7684\u672c\u5730\u5b89\u5168\u8bc1\u636e\u58f0\u660e\u96c6\u5408\uff0c\u6240\u8ff0\u653b\u51fb\u884c\u4e3a\u56fe\u5305\u62ec\u884c\u4e3a\u8282\u70b9\u548c\u884c\u4e3a\u8282\u70b9\u4e4b\u95f4\u7684\u5173\u8054\u8fb9\uff0c\u6240\u8ff0\u672c\u5730\u5b89\u5168\u8bc1\u636e\u58f0\u660e\u5305\u62ec\u80fd\u591f\u56de\u6307\u81f3\u539f\u59cb",
        "style": "Normal"
      },
      {
        "para_index": 6,
        "text": "2. \u6839\u636e\u6743\u5229\u8981\u6c421\u6240\u8ff0\u7684\u65b9\u6cd5\uff0c\u5176\u7279\u5f81\u5728\u4e8e\uff0c\u9488\u5bf9\u4efb\u4e00\u884c\u4e3a\u8282\u70b9\uff0c\u5c06\u4e0e\u8be5\u884c\u4e3a\u8282\u70b9\u5173\u8054\u7684\u5fc5\u9700\u5b89\u5168\u8bc1\u636e\u58f0\u660e\u6309\u6765\u6e90\u7ec4\u8fdb\u884c\u5212\u5206\uff0c\u5e76\u4e3a\u6240\u8ff0\u884c\u4e3a\u8282\u70b9\u8bbe\u7f6e\u6765\u6e90\u652f\u6301\u9608\u503c k\uff1b\u5f53\u5f53\u524d\u53ef\u89c1\u5b89\u5168\u8bc1\u636e\u58f0\u660e\u8986\u76d6\u7684\u72ec\u7acb\u6765\u6e90\u7ec4\u6570\u91cf\u4e0d\u5c0f\u4e8e\u6240\u8ff0\u6765\u6e90\u652f\u6301\u9608\u503c k \u65f6\uff0c\u5c06\u8be5\u884c\u4e3a\u8282\u70b9",
        "style": "Normal"
