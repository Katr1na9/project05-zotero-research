@misc{cheng_kairos_2023,
	title = {Kairos: practical intrusion detection and investigation using whole-system provenance},
	shorttitle = {Kairos},
	url = {http://arxiv.org/abs/2308.05034},
	doi = {10.48550/arXiv.2308.05034},
	abstract = {Provenance graphs are structured audit logs that describe the history of a system's execution. Recent studies have explored a variety of techniques to analyze provenance graphs for automated host intrusion detection, focusing particularly on advanced persistent threats. Sifting through their design documents, we identify four common dimensions that drive the development of provenance-based intrusion detection systems (PIDSes): scope (can PIDSes detect modern attacks that infiltrate across application boundaries?), attack agnosticity (can PIDSes detect novel attacks without a priori knowledge of attack characteristics?), timeliness (can PIDSes efficiently monitor host systems as they run?), and attack reconstruction (can PIDSes distill attack activity from large provenance graphs so that sysadmins can easily understand and quickly respond to system intrusion?). We present KAIROS, the first PIDS that simultaneously satisfies the desiderata in all four dimensions, whereas existing approaches sacrifice at least one and struggle to achieve comparable detection performance. Kairos leverages a novel graph neural network-based encoder-decoder architecture that learns the temporal evolution of a provenance graph's structural changes to quantify the degree of anomalousness for each system event. Then, based on this fine-grained information, Kairos reconstructs attack footprints, generating compact summary graphs that accurately describe malicious activity over a stream of system audit logs. Using state-of-the-art benchmark datasets, we demonstrate that Kairos outperforms previous approaches.},
	language = {en},
	urldate = {2025-09-22},
	publisher = {arXiv},
	author = {Cheng, Zijun and Lv, Qiujian and Liang, Jinyuan and Wang, Yan and Sun, Degang and Pasquier, Thomas and Han, Xueyuan},
	month = sep,
	year = {2023},
	note = {arXiv:2308.05034 [cs]},
	keywords = {Computer Science - Machine Learning, Computer Science - Cryptography and Security},
	annote = {Abstract:
确定了驱动基于起源的入侵检测系统( PIDSes )发展的四个共同维度：
范围( PIDS可以检测跨应用边界渗透的现代攻击。)
攻击性( PIDS可以在没有攻击特征先验知识的情况下检测到新的攻击。)
及时性( PIDSes可以在运行时有效地监控主机系统)。 )
攻击重构( PIDSes可以从大的起源图中提取攻击活动,以便系统管理员容易理解并快速响应系统入侵。)
提出了KAIROS，这是第一个同时满足所有四个维度要求的PIDS，而现有的方法至少牺牲了一个，并且很难达到可比的检测性能。KAIROS采用了一种新颖的基于图神经网络的编码器-解码器结构，通过学习起源图结构变化的时间演化来量化每个系统事件的异常程度。 然后，基于这些细粒度信息，KAIROS重构攻击足迹，生成紧凑的摘要图，准确地描述系统审计日志流中的恶意行为。使用最先进的基准数据集，我们证明了KAIROS优于以前的方法。
KAIROS精确地重建了攻击足迹，显著地减少了系统管理员理解攻击所必须检查的图边的数量
},
	annote = {Comment: 24 pages, 16 figures, to appear in the 45th IEEE Symposium on Security and Privacy (S\&P'24)},
	annote = {Comment: 24 pages, 16 figures, to appear in the 45th IEEE Symposium on Security and Privacy (S\&P'24)},
	file = {Full Text PDF:C\:\\Users\\35393\\Zotero\\storage\\L8U74NSR\\Cheng 等 - 2023 - Kairos practical intrusion detection and investigation using whole-system provenance.pdf:application/pdf;Snapshot:C\:\\Users\\35393\\Zotero\\storage\\3ASUCRH6\\2308.html:text/html},
}

@misc{bae_threat_2024,
	title = {Threat behavior textual search by attention graph isomorphism},
	url = {http://arxiv.org/abs/2404.10944},
	doi = {10.48550/arXiv.2404.10944},
	abstract = {Cyber attacks cause over {\textbackslash}\$1 trillion loss every year. An important task for cyber security analysts is attack forensics. It entails understanding malware behaviors and attack origins. However, existing automated or manual malware analysis can only disclose a subset of behaviors due to inherent difficulties (e.g., malware cloaking and obfuscation). As such, analysts often resort to text search techniques to identify existing malware reports based on the symptoms they observe, exploiting the fact that malware samples share a lot of similarity, especially those from the same origin. In this paper, we propose a novel malware behavior search technique that is based on graph isomorphism at the attention layers of Transformer models. We also compose a large dataset collected from various agencies to facilitate such research. Our technique outperforms state-of-the-art methods, such as those based on sentence embeddings and keywords by 6-14\%. In the case study of 10 real-world malwares, our technique can correctly attribute 8 of them to their ground truth origins while using Google only works for 3 cases.},
	language = {en},
	urldate = {2025-08-12},
	publisher = {arXiv},
	author = {Bae, Chanwoo and Tao, Guanhong and Zhang, Zhuo and Zhang, Xiangyu},
	month = apr,
	year = {2024},
	note = {arXiv:2404.10944 [cs]},
	keywords = {Computer Science - Information Retrieval},
	annote = {Abstract：
网络攻击每年造成超过1万亿美元的损失。网络安全分析人员的一项重要任务是攻击取证。这需要理解恶意软件的行为和攻击来源。然而，由于(例如,恶意软件的伪装和混淆)的固有困难，现有的自动化或人工恶意软件分析只能揭示行为的子集。因此，分析人员通常使用文本搜索技术，根据他们观察到的症状来识别现有的恶意软件报告，利用恶意软件样本具有许多相似性的事实，特别是来自相同来源的样本。在本文中，我们提出了一种新颖的恶意软件行为搜索技术，该技术基于Transformer模型注意力层的图同构。 我们还编写了一个从不同机构收集的大型数据集，以促进此类研究。我们的方法比目前最先进的方法，如基于句子嵌入和关键词的方法提高了6 - 14 \%。在对10个真实恶意软件的案例研究中，我们的技术可以正确地将其中的8个归因于它们的真实来源，而使用谷歌只适用于3个案例。



Introduction：
网络攻击是我们日常生活中的一个突出威胁，每年造成超过1万亿美元的损失。因此，防御和减轻网络攻击至关重要。军备竞赛中的一项重要任务是攻击取证，其目的是确定恶意软件的行为、损害和起源。它通常从一个攻击实例开始，例如，在野外捕获的恶意软件样本。分析人员使用IDA 等工具检查其代码体，使用Cuckoo等沙盒技术执行并观察其运行时行为。攻击取证是重要的，因为其结果可以用来评估损害和防止未来的攻击。 然而，恶意软件通常采用复杂的自我保护，如混淆以改变代码体，使其难以理解和/或伪装成一个良性的应用程序，以及隐藏恶意载荷，直到满足某些(攻击)条件。因此，分析师通常只能披露恶意软件行为的一部分。因此，它们严重依赖文本搜索来发现现有的相关恶意软件报告。这种搜索通常由观察到的行为驱动，如破坏，数据溢出(关于它们是如何执行的。)。其理由是，网络攻击变得越来越有组织性，在所使用的利用方面表现出相当大的共同性，交付的有效载荷，以及它们的目标，特别是由同一威胁参与者( Malpedia ) (即,敌手或敌手组织)发起的。因此，人们可以从现有恶意软件样本的报告中预测新恶意软件的全部行为，这些样本与新样本具有某些共性。事实上，各大安全厂商已经发布了大量的恶意软件分析报告。虽然它们具有为未来分析提供集体情报的巨大潜力，但在充分利用这些知识方面存在固有的障碍，即这些威胁报告是以非结构化和非正式的自然语言编写的。由于任何人都可以发表此类报告，因此很难对其进行标准化。
因此，关键问题是一个专门的文本搜索挑战，根据该领域使用的术语，称为网络威胁情报( CTI )搜索。CTI搜索面临两个主要挑战；( i )由于缺乏有标签的数据集，监督学习几乎不可行；( ii )现有的预训练通用语言模型无法有效捕捉领域特定的语义。有时候，通用语言模型的微小变化就意味着CTI中存在着巨大的语义差异。例如，一个"文件"既可以描述信息窃取( ' file to leak arXiv : 2404.10944v2 [ cs . IR ] 18 2024年4月从程序中窃取的数据')，也可以描述程序利用( "文件利用程序窃取数据")。 最流行的搜索方法直接使用恶意软件样本的妥协指标( IoCs )，例如恶意软件文件哈希( Catakoglu et al , 2016 ; Liao et al , 2016)。它是目前广泛使用的恶意软件分析平台VirusTotal ( VirusTotal )中使用的方法。尽管使用IoCs精确且不存在误报，但它无法处理众所周知的恶意软件变异问题( Liao et al , 2016)，即恶意软件频繁且一致地更改其配置、有效载荷甚至攻击步骤，以逃避检测或简单地更新其功能。另一种方法是基于文本相似度的恶意软件行为搜索。现有的文本相似度方法主要分为两类：基于关键词的方法，2015 )和基于句子嵌入的方法.前者侧重于特定领域的关键词。它不能有效地提取关键词之间的关系，而这些关键词在CTI搜索中是至关重要的。在上面的例子中，关键字"文件"需要与其他词(即"泄漏"或"利用")的关系进行分析- -基于关键字的搜索(即"偷"、"程序"、"数据")会引起误解。相比之下，直接使用嵌入词往往会不必要地分散对CTI搜索不关键的词的注意力。
CTI搜索（Cyber Threat Intelligence Search）​​ 是指利用专门的工具、技术和方法，在网络安全领域内系统地收集、分析、关联和挖掘关于潜在或正在发生的网络威胁信息（即网络威胁情报，CTI）​​ 的过程。其核心目标是帮助组织更好地理解威胁环境、预测攻击、防御针对性威胁并做出明智的安全决策。
},
	file = {Preprint PDF:C\:\\Users\\35393\\Zotero\\storage\\LJVTHVRD\\Bae 等 - 2024 - Threat behavior textual search by attention graph isomorphism.pdf:application/pdf;Snapshot:C\:\\Users\\35393\\Zotero\\storage\\5VP9T2Y9\\2404.html:text/html},
}

@misc{fang_tracing_2022,
	title = {Tracing the origin of adversarial attack for forensic investigation and deterrence},
	url = {http://arxiv.org/abs/2301.01218},
	doi = {10.48550/arXiv.2301.01218},
	abstract = {Deep neural networks are vulnerable to adversarial attacks. In this paper, we take the role of investigators who want to trace the attack and identify the source, that is, the particular model which the adversarial examples are generated from. Techniques derived would aid forensic investigation of attack incidents and serve as deterrence to potential attacks. We consider the buyers-seller setting where a machine learning model is to be distributed to various buyers and each buyer receives a slightly different copy with same functionality. A malicious buyer generates adversarial examples from a particular copy \${\textbackslash}mathcal\{M\}\_i\$ and uses them to attack other copies. From these adversarial examples, the investigator wants to identify the source \${\textbackslash}mathcal\{M\}\_i\$. To address this problem, we propose a two-stage separate-and-trace framework. The model separation stage generates multiple copies of a model for a same classification task. This process injects unique characteristics into each copy so that adversarial examples generated have distinct and traceable features. We give a parallel structure which embeds a ``tracer'' in each copy, and a noise-sensitive training loss to achieve this goal. The tracing stage takes in adversarial examples and a few candidate models, and identifies the likely source. Based on the unique features induced by the noise-sensitive loss function, we could effectively trace the potential adversarial copy by considering the output logits from each tracer. Empirical results show that it is possible to trace the origin of the adversarial example and the mechanism can be applied to a wide range of architectures and datasets.},
	language = {en},
	urldate = {2025-08-12},
	publisher = {arXiv},
	author = {Fang, Han and Zhang, Jiyi and Qiu, Yupeng and Xu, Ke and Fang, Chengfang and Chang, Ee-Chien},
	month = dec,
	year = {2022},
	note = {arXiv:2301.01218 [cs]},
	keywords = {Computer Science - Machine Learning, Computer Science - Cryptography and Security, Computer Science - Computer Vision and Pattern Recognition},
	annote = {Abstract:
深度神经网络容易受到对抗攻击。本文采取的是侦查人员的角色，侦查人员想要追踪攻击并识别来源，也就是对抗样本产生的特定模型。衍生的技术将有助于攻击事件的调查，并对潜在的攻击起到威慑作用。我们考虑买家-卖家的环境，其中机器学习模型将被分发给不同的买家，并且每个买家收到具有相同功能的略有不同的副本。恶意的买家从特定的副本Mi生成对抗样本，并使用它们来攻击其他副本。从这些对抗的例子中，侦查人员想要识别出来源Mi。 为了解决这个问题，我们提出了一个两阶段的分离跟踪框架。模型分离阶段为同一分类任务生成一个模型的多个副本。该过程为每个副本注入独特的特征，使得生成的对抗样本具有鲜明的、可追溯的特征。我们给出了一个并行结构，在每个副本中嵌入一个"追踪器"，以及一个对噪声敏感的训练损失来实现这个目标。追踪阶段采用对抗样本和少数候选模型，并识别可能的来源。基于对噪声敏感的损失函数所诱导的独特特征，我们可以通过考虑每个示踪器的输出logit来有效地追踪潜在的对抗拷贝。 实验结果表明，可以追溯对抗样本的来源，并且该机制可以应用于广泛的架构和数据集。
对抗攻击：在机器学习和人工智能领域，​对抗攻击是指通过精心设计的输入数据（对抗样本）欺骗模型，使其产生错误输出的攻击方式。这类攻击通常针对深度学习模型（如CNN、NLP模型），但也可能影响传统机器学习算法。


Introduction:
深度学习模型容易受到对抗攻击。通过对输入样本引入特定的扰动，即使扰动样本在视觉上接近干净图像也可能误导网络模型给出错误的预测。现有的许多工作都是针对攻击进行防御。遗憾的是，虽然目前的防御措施在一定程度上缓解了这种攻击，但这种威胁还远未被完全消除。
Buyers-seller Setting:
在此设定下，卖方S将m个分类模型Mi，i∈[ 1 , m]分配给不同的买方b。这些模型使用相同的训练数据集，针对相同的分类任务进行训练。这些模型以黑盒的形式提供给买家，例如，这些模型可以嵌入到FPGA和ASIC等硬件中，也可以在机器学习即服务( MLaaS )平台中提供。因此，买方只有黑盒访问，这意味着他只能查询硬标签的模型。此外，我们假设买家不知道训练数据集。销售商拥有充分的知识，因此对所有分布式模型都有白盒访问权限。
黑盒：将系统视为一个不透明的“盒子”，​仅关注输入和输出，不关心内部实现细节，代码、算法、数据结构等对用户/测试者隐藏。只验证系统是否按预期工作（例如：输入A是否输出B）
白盒：系统内部完全透明，​可查看和修改代码、逻辑、数据结构，强调内部逻辑的正确性。开发者/测试者需理解代码实现。测试覆盖代码路径（如分支、循环、条件语句）。
Attack and Traceability:
恶意买家想要攻击其他受害买家。恶意买方不直接访问其他模型，因此从自己的模型中生成实例，然后部署找到的实例。例如，恶意买家可能会利用其自动驾驶车辆生成路标的对抗示例，然后对路标进行物理污损以欺骗过往车辆。现在，作为获得污损路标的法医侦查人员，我们想要了解对抗样本是如何生成的，并对生成样本所用到的模型进行溯源。
Proposed Framework:
我们的解决方案分为两个阶段：模型分离和溯源。在模型分离阶段，给定一个分类任务，我们希望生成多个模型，这些模型在分类任务上具有较高的准确性，但对于追踪来说具有足够的差异性。换句话说，我们希望主动增强模型之间的差异，以便于跟踪。为了实现这一目标，我们提出了一种并行的网络结构，将唯一的示踪器与原始分类模型配对。示踪器的作用是修改输出，从而诱使攻击者产生具有独特特征的对抗样本。我们给示踪器一个噪声敏感的训练损失。


Related Work:
在本文中，我们采用黑盒设置，敌手只能查询模型并得到输出的硬标签(最终决策)。许多现有的攻击都假设白盒设置攻击通常直接依赖于受害者模型提供的梯度信息。由于模型的详细信息隐藏在黑盒设置中，黑盒攻击往往被认为比较困难，工作较少。Chen等人提出了一种称为零阶优化( ZOO ) ( Chen et al 2017)的黑盒攻击。 ZOO仅通过查询网络模型，就可以用有限差分数值估计来逼近目标函数的梯度。因此，近似梯度被用于生成对抗样本。Guo等人提出了一种简单的黑盒对抗攻击，称为" SimBA " ( Guo et al . 2019)，用于生成一组正交向量的对抗样本。通过对加入选择向量后的输出Logit进行测试，可以有效地找到优化方向。布伦德尔等人开发了一种基于决策的对抗攻击，称为"边界攻击" (布伦德尔、Rauber和Bethge 2018)，它通过迭代地将属于不同标签的另一个初始图像扰动到原始标签和相邻标签之间的决策边界。 通过查询具有足够多扰动图像的模型，可以找到边界和扰动，从而生成对抗样本。Chen等人最近提出了另一种基于决策的攻击，即跳跃式跳跃攻击( hop-skip-jump attack，HSJA ) ( Chen , Jordan和温赖特2020)。仅利用决策边界处的二值信息和蒙特卡洛估计即可找到网络的梯度方向，从而实现对抗样本生成。在( Chen , Jordan和温赖特2020)的基础上，Li et al . ( Li et al 2020)提出了一种高效的基于边界的黑盒攻击QEBA，该攻击在多个变换空间中估计边界的梯度，有效地减少了生成对抗样本时的查询次数。Maho et al . ( Maho , Furon , Le Merrer 2021)提出了一种不估计梯度而是基于极坐标搜索边界的无代理黑盒攻击，与( Chen , Jordan和温赖特2020)和( Li et al 2020)相比，( Maho , Furon , Le Merrer 2021)以更少的查询次数实现了更小的失真。


Proposed Framework:
我们设计了一个包含模型分离和原点追踪两个阶段的框架:
在模型分离阶段，我们希望生成多个模型，这些模型在对抗攻击下具有足够的差异性，同时在分类任务上保持高度的准确性。我们的主要思想是一个并行的网络结构，它将一个独特的示踪器与原始的分类器配对。
在溯源方面，我们利用了不同示踪物在平行结构中的独特特征，这些特征可以在示踪物的logits中观察到。因此，我们的追踪过程是通过将对抗样本输入到追踪器中并分析它们的输出来进行的。
Model Separation:
设计了一个并行网络结构来生成分布式模型Mi，i∈[ 1 , m]，其中包含一个示踪模型Ti和一个主模型C，。Ti用于为攻击者注入独特的特征和设置陷阱。C是针对原始任务训练的网络。最终结果由C和Ti共同决定，权重参数为α。在每个分布式模型中，C是固定的，只有Ti是不同的。Ti的具体结构如图3b所示，它由一个' SingleConv ' block ( Conv-BNReLU )，两个' Res-block ' ( He et al.2016)，一个' Conv ' block，一个全连接block和一个' Tanh '激活层线性级联而成。Ti的训练过程可以描述为：1 )给定训练数据集1和示踪剂Ti，我们首先用随机参数初始化Ti。 2 )对每个训练历元，在输入图像x上添加随机噪声N o 2，生成加噪图像x No。3 )然后将x和xNo同时送入Ti，得到输出Ox和OxNo。我们试图使Ti对噪声敏感，因此Ox和OxNo应该尽可能的不同。Ti的损失函数可以写为：














