@techreport{nanda_rani_comprehensive_2024,
	title = {A comprehensive survey of advanced persistent threat attribution: taxonomy, methods, challenges and open research problems},
	shorttitle = {A comprehensive survey of advanced persistent threat attribution},
	url = {https://arxiv.org/abs/2409.11415},
	abstract = {??????? APT ????????????},
	language = {en},
	institution = {arXiv},
	author = {{Nanda Rani} and {Bikash Saha} and {Sandeep Kumar Shukla}},
	year = {2024},
	keywords = {agent, attack-chain, cyber-threat-intelligence, explainable-security, intent-recognition, knowledge-graph, llm, threat-attribution, APT attribution, survey, taxonomy},
	annote = {APT威胁溯源---survey
这个 taxonomy 从几个维度组织归因研究：


Level：归因层级、粒度与置信度也就是归因到什么程度：


IP / 域名 / 基础设施层面；


恶意软件家族；


攻击活动 campaign；


APT 组织 / 威胁行为体；


国家、组织或动机层面。


粒度越高，证据要求越强，不确定性也越大。


How / Where：证据如何处理、从哪里来这里关注技术分析过程：


日志分析；


恶意软件分析；


网络流量分析；


威胁情报分析；


TTP / ATT\&CK 映射；


图分析；


机器学习和 AI 辅助归因。




Why / Who：攻击动机与攻击者画像不只是“攻击来自哪里”，还包括：


政治动机；


经济利益；


间谍活动；


破坏性攻击；


黑产组织、APT 组织、国家支持行为体等。






红队：模拟攻击者的一方。他们会站在攻击者视角，尝试入侵系统、突破防御、利用漏洞、伪装身份、横向移动、窃取数据等。红队不一定是真正的恶意黑客，而是“被授权的攻击模拟者”。在研究里，红队常用来代表攻击行为、攻击链、TTPs、组织战术风格等。
蓝队：负责防御、监测和响应的一方。他们的任务是发现攻击、分析日志、溯源攻击路径、判断攻击意图、修补漏洞、响应事件、提升检测规则等。蓝队更接近安全运营中心 SOC、安全分析员、应急响应团队、防守方研究人员。
C\&C 是：Command and Control，也常写作 C2，中文一般叫：命令与控制基础设施 / 攻击指挥控制服务器
在网络攻击里，它指的是攻击者用来远程控制被感染主机的一套通信设施。比如攻击者先让恶意软件感染目标电脑，然后这台电脑会偷偷连接攻击者控制的域名、服务器或 IP，等待下一步指令。
},
	file = {A Comprehensive Survey of Advanced Persistent Threat Attribution Taxonomy, Methods, Challenges and Open Research Problems:C\:\\Users\\35393\\Zotero\\storage\\YTZ6L89F\\A Comprehensive Survey of Advanced Persistent Threat Attribution Taxonomy, Methods, Challenges and Open Research Problems.pdf:application/pdf},
}

