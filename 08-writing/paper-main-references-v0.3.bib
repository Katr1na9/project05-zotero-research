@inproceedings{han_unicorn_2020,
	title = {{UNICORN}: runtime provenance-based detector for advanced persistent threats},
	shorttitle = {Unicorn},
	url = {http://arxiv.org/abs/2001.01525},
	doi = {10.14722/ndss.2020.24046},
	abstract = {Advanced Persistent Threats (APTs) are difficult to detect due to their "low-and-slow" attack patterns and frequent use of zero-day exploits. We present UNICORN, an anomaly-based APT detector that effectively leverages data provenance analysis. From modeling to detection, UNICORN tailors its design specifically for the unique characteristics of APTs. Through extensive yet time-efficient graph analysis, UNICORN explores provenance graphs that provide rich contextual and historical information to identify stealthy anomalous activities without pre-defined attack signatures. Using a graph sketching technique, it summarizes long-running system execution with space efficiency to combat slow-acting attacks that take place over a long time span. UNICORN further improves its detection capability using a novel modeling approach to understand long-term behavior as the system evolves. Our evaluation shows that UNICORN outperforms an existing state-of-the-art APT detection system and detects real-life APT scenarios with high accuracy.},
	language = {en},
	urldate = {2025-08-12},
	booktitle = {Proceedings 2020 {Network} and {Distributed} {System} {Security} {Symposium}},
	author = {Han, Xueyuan and Pasquier, Thomas and Bates, Adam and Mickens, James and Seltzer, Margo},
	year = {2020},
	note = {arXiv:2001.01525 [cs]},
	keywords = {Computer Science - Cryptography and Security},
	file = {Preprint PDF:C\:\\Users\\35393\\Zotero\\storage\\GRIRI573\\Han 等 - 2020 - UNICORN runtime provenance-based detector for advanced persistent threats.pdf:application/pdf;Snapshot:C\:\\Users\\35393\\Zotero\\storage\\C4X5HLC5\\2001.html:text/html},
}

@article{noauthor_slot_nodate,
	title = {Slot: {Provenance}-{Driven} {APT} {Detection} through {Graph} {Reinforcement} {Learning}},
	language = {en},
	annote = {Abstract：
APT：恶意攻击者获得未授权的网络访问，并在很长一段时间里未被发现，从而窃取敏感数据或破坏系统操作
传统方法要么准确性不足，要么产生结果的时间过长，近年来开始引入图学习，大致可以分为三种


基于统计的方法：考虑不频繁的事件作为可疑事件，使用起源图对这些事件进行建模和识别。然而，这些方法仅仅关注直接的事件连接，忽略了起源图中的深层语义和隐藏关系，这可能导致高误报率和可靠性降低。


基于规范的方法：利用专家知识为APT检测制定启发式规则。 虽然该方法在所覆盖的案例中有效地保持了较低的误报率，但创建这些启发式规则需要大量的专家先验知识，这些知识必须由专家进行提取和提炼，使其成为一个资源密集型的过程。


基于学习的方法：利用各种深度学习技术对APT攻击模式和系统行为进行建模，然后利用这些模型进行APT检测。特别是通过整合溯源图和图神经网络( GNN )，可以揭示系统事件之间的联系，从而增强APT检测。 然而，它们仍然容易受到对抗攻击的影响，攻击者很容易模仿合法用户来误导模型产生错误的检测结果。


Slot通过利用潜在行为挖掘和图强化学习从系统行为数据中深度挖掘多层次隐藏关系(因果依赖关系,上下文交互和间接攻击痕迹)，实现了增强的APT检测精度。此外，通过结合图强化学习，Slot可以自主地学习和适应新的用户活动和攻击策略，而不依赖于来自专家见解的威胁报告，从而增强其对对抗攻击的适应性和弹性。 此外，Slot能够自动构建攻击链，准确识别攻击路径，简化了防御过程。
Slot由五个集成模块组成：


图构建模块：该模块处理系统日志以创建反映系统行为的初始起源图。


潜在行为挖掘模块：应用注意力机制和图转换技术来发现图内的隐藏关系，增强了后续分析的深度和全面性。


嵌入模块：使用图强化学习算法(即. Bernoulli多臂赌博机，将图节点的语义和拓扑特征嵌入为向量，聚合相似节点，产生更新的特征向量，过滤掉伪装的实体，从而提高准确率和鲁棒性。

Bernoulli 多臂老虎机：老虎机比喻：​​
想象你站在一台有 K 个摇臂的老虎机前。每个摇臂 i 代表一个选择（例如：推荐算法中的一个新闻项、临床试验中的一个治疗方案、在线广告中的一个广告位），每次拉动一个摇臂 i 后，你会得到一个二元随机奖励（Reward）R：要么是成功（1），要么是失败（0）。​​ 这就是 ​​“Bernoulli”​​ 特性的来源，即奖励服从伯努利分布。每个摇臂 i 有一个隐藏的、未知的成功概率 pᵢ (0 ≤ pᵢ ≤ 1)​。这就是拉动该摇臂获得奖励 1 的概率。算法目标是设计一个策略（算法），在一系列 N 次拉动中（或无限期进行），尽可能多地获得累积奖励（即尽可能多地获得“1”）。就是一个模拟在多个未知成功概率的二选择之间做决策的数学模型。其核心特点是奖励只有 0 或 1，决策者面临的关键挑战是如何在尝试新选择（探索）和坚持当前认为最好的选择（利用）之间取得平衡，目标是最大化总奖励（1 的数量）



威胁检测模型：该模型结合多层感知器( MLP )和孤立森林(孤立森林)来综合识别APTs。

Isolation Forest（隔离森林）​​ ：是一种高效的无监督异常检测算法，特别擅长从高维数据中识别异常点（Outlier）它的核心思想是：异常数据点数量少且与正常数据差异大，因此更容易被‘隔离’（分离）出来。利用异常点更容易被随机规则快速隔离（路径长度短）​​ 这一核心特性来检测异常。它为每个数据点计算一个异常得分​（接近 1 表示异常）。核心思想如下：想象一下要在树林里找出一个异类（比如一棵塑料树）。正常树木彼此相似、分布密集，很难单独隔离出来，需要砍伐很多树才能围住它（即在数据空间中分割它需要复杂的边界）。而塑料树与众不同，很容易用几刀（即很少的规则）就把它从森林里分离出来。



攻击链重构模块：通过对关联节点进行聚类，追踪攻击路径，辅助制定有效的防御策略。





Related Work and Its Limitations：
APT检测（同上）
图强化学习：研究人员发现，RL方法通过分析节点、链接和子图等关键组件，能够有效地探索图的拓扑结构和属性信息。SUGAR使用Q-learning自适应地选择重要的子图来表示图的判别信息。通过优化多目标得分，提出了图数据局部解释的扰动策略。 但目前，图强化学习在日志起源检测领域尚未有尝试。
Slot是一种细粒度、对抗性的威胁溯源方案。利用注意力机制和图转换技术来挖掘深层隐藏的关系，然后将RL与溯源图相结合，以指导GNN中的关系聚合。槽具有灵活的策略扩展能力和动态适应性，使其能够应对现实场景中的对抗攻击。Slot不仅通过模型学习提供恶意检测，还提出了一种考虑未知异常的方法。最后，通过集成LPA和ATT \& CK编码，提供了简洁且低假阳性的攻击链，有效地加速了人工验证。

Problem Formalization:
Methodolgy:
Graph Construction:
Slot利用从Windows ETW、Linux Audit、Cam Flow 等日志基础设施收集的审计数据构建了一个全面的系统溯源图。它遵循溯源图的现有定义，并采用最新的图预处理技术，将事件抽象为主体、对象和关系；其中，进程线程等源节点代表主体，Files或sockets等目标节点代表客体，系统调用事件作为关系形成图G( S、R、O)。Slot充分考虑了进程节点的进程名和命令行参数、文件节点的文件路径、netflow技术节点的网络IP地址和端口等有意义的语义信息。Slot通过聚合语义属性(进程名、文件路径、IP)和单跳的的因果事件(系统调用)来构建节点"摘要句"，结合时间戳排序的事件序列和位置编码来保留时间关系，并利用Word2Vec模型[ 37 ]来学习语义特征的向量表示，从而有效地挖掘起源日志中的深层语义模式。
Latent Behavior Mining：
该模块通过关系注意力机制自动构建跨多跳节点的隐藏关系，优先考虑因果链和攻击相关的上下文模式。
Embedding with Graph Reinforcement Learning：
Slot利用图强化学习从起源图中获得高质量的节点嵌入。嵌入模块包括3个阶段：
在相似性感知阶段，将节点的语义特征和拓扑特征嵌入到向量中。
在节点特征向量相似度计算的基础上，利用强化学习设计了一种自适应Bandit邻居选择器。
我们通过整合多个关系(包括系统调用和潜在关系)来聚合特征，以生成更新的节点特征向量。











},
	file = {PDF:C\:\\Users\\35393\\Zotero\\storage\\ME78XWX6\\_.pdf:application/pdf},
}

@misc{golec_llm-driven_2025,
	title = {{LLM}-driven {APT} detection for {6G} wireless networks: a systematic review and taxonomy},
	shorttitle = {{LLM}-driven {APT} detection for {6G} wireless networks},
	url = {http://arxiv.org/abs/2505.18846},
	doi = {10.48550/arXiv.2505.18846},
	abstract = {Sixth Generation (6G) wireless networks, which are expected to be deployed in the 2030s, have already created great excitement in academia and the private sector with their extremely high communication speed and low latency rates. However, despite the ultra-low latency, high throughput, and AI-assisted orchestration capabilities they promise, they are vulnerable to stealthy and long-term Advanced Persistent Threats (APTs). Large Language Models (LLMs) stand out as an ideal candidate to fill this gap with their high success in semantic reasoning and threat intelligence. In this paper, we present a comprehensive systematic review and taxonomy study for LLM-assisted APT detection in 6G networks. We address five research questions, namely, semantic merging of fragmented logs, encrypted traffic analysis, edge distribution constraints, dataset/modeling techniques, and reproducibility trends, by leveraging most recent studies on the intersection of LLMs, APTs, and 6G wireless networks. We identify open challenges such as explainability gaps, data scarcity, edge hardware limitations, and the need for real-time slicing-aware adaptation by presenting various taxonomies such as granularity, deployment models, and kill chain stages. We then conclude the paper by providing several research gaps in 6G infrastructures for future researchers. To the best of our knowledge, this paper is the first comprehensive systematic review and classification study on LLM-based APT detection in 6G networks.},
	language = {en},
	urldate = {2025-07-31},
	publisher = {arXiv},
	author = {Golec, Muhammed and Khamayseh, Yaser and Melhem, Suhib Bani and Alwarafy, Abdulmalik},
	month = jun,
	year = {2025},
	note = {arXiv:2505.18846 [cs]},
	keywords = {Computer Science - Cryptography and Security},
	annote = {Comment: 22 pages, 11 figures, 8 tables. Submitted to Computer Science Review (Elsevier), May 2025},
	file = {Snapshot:C\:\\Users\\35393\\Zotero\\storage\\UTFM4NW5\\2505.html:text/html},
}

@misc{gandhi_shield_2025,
	title = {{SHIELD}: {APT} detection and intelligent explanation using {LLM}},
	shorttitle = {Shield},
	url = {http://arxiv.org/abs/2502.02342},
	doi = {10.48550/arXiv.2502.02342},
	abstract = {Advanced persistent threats (APTs) are sophisticated cyber attacks that can remain undetected for extended periods, making their mitigation particularly challenging. Given their persistence, significant effort is required to detect them and respond effectively. Existing provenance-based attack detection methods often lack interpretability and suffer from high false positive rates, while investigation approaches are either supervised or limited to known attacks. To address these challenges, we introduce SHIELD, a novel approach that combines statistical anomaly detection and graph-based analysis with the contextual analysis capabilities of large language models (LLMs). SHIELD leverages the implicit knowledge of LLMs to uncover hidden attack patterns in provenance data, while reducing false positives and providing clear, interpretable attack descriptions. This reduces analysts' alert fatigue and makes it easier for them to understand the threat landscape. Our extensive evaluation demonstrates SHIELD's effectiveness and computational efficiency in real-world scenarios. SHIELD was shown to outperform state-of-the-art methods, achieving higher precision and recall. SHIELD's integration of anomaly detection, LLM-driven contextual analysis, and advanced graph-based correlation establishes a new benchmark for APT detection.},
	language = {en},
	urldate = {2025-07-23},
	publisher = {arXiv},
	author = {Gandhi, Parth Atulbhai and Wudali, Prasanna N. and Amaru, Yonatan and Elovici, Yuval and Shabtai, Asaf},
	month = feb,
	year = {2025},
	note = {arXiv:2502.02342 [cs]},
	keywords = {Computer Science - Cryptography and Security},
	annote = {Deep collision scan candidate. Provenance graph, LLM multi-stage reasoning, confidence scoring, APT detection and explanation.},
	annote = {Introduction
研究背景：
“Advanced persistent threats (APTs) are becoming a growing concern for today’s organizations due to their sophistication and stealth.”
自第一段起至第二段“provenance data can expose subtle patterns and lateral movements characteristic of sophisticated attacks.”
研究痛点：
现有检测方法有局限性，需要不断更新同零日攻击作斗争；转向ML之后仍面临局限性：


需要大量训练数据，难以适应动态攻击模式，从而导致较高的误报率。


现有的方法依赖于有标记的训练数据，这些数据生成繁琐且很快成为过时；或者专注于ML可解释性而不是攻击的具体特征


选择引入LLM，亦有局限性：


不能将原始日志传入LLM


LLM会产生幻觉


解决方法
提出SHIELD模型：


使用统计分析来标记异常事件


构建溯源图以确定关系


精简良性活动


利用社区检测算法对可疑事件进行聚类

    社区检测算法：community指的是网络中连接异常紧密的子图或节点集合。社区内部的节点之间连接非常多且密集，社区之间的节点连接相对稀少且稀疏；community structure是指整个网络由多个这样的社区组成，形成一个模块化（modular）的结构；社区检测算法的目标就是自动、有效地识别出这些隐藏的社区结构，无需事先知道社区的个数或每个节点属于哪个社区（即无监督学习）


它使用衰减和增强机制进行动态置信度评分。如果标记过程一致地表现出良性行为，衰减机制会降低置信度分数，而强化机制会随着跨时间窗口检测到额外的攻击阶段而增加分数。
研究成果


首次将LLMs用于APT的检测和研究，在最小化误报的同时实现了较高的检测精度。


开发了新的引擎使之可以在很长的时间内跟踪攻击；同时使用具有强化和衰减机制的动态置信度评分，有效地识别缓慢进化的隐形攻击。


能够生成人类可解释的、全面的攻击摘要，将攻击事件映射到杀伤链阶段。这些总结与相关的IoC一起，使安全团队能够快速分析和应对潜在的威胁。


利用了现成的LLMs的能力，不需要传统的模型训练。与基于深度学习的方法遭受概念漂移不同，我们的系统通过基于提示的组织变革的情境化来保持适应性。




Related Work
主要局限性概括如下：


基于规则的方法需要人工努力，无法检测零日攻击


基于异常的方法不能适应随时间演化的系统行为，导致较高的误报率


基于异常的方法生成的警报缺乏可解释性，使得安全分析人员难以对检测到的异常进行调查


在许多情况下，所进行的评估使用了不反映真实世界场景的训练数据，导致了膨胀(错误)的性能结果


现有方法面临可扩展性和高计算需求的挑战，限制了它们的实际部署


LLMs在APT探测和调查任务中的应用不足，尤其是溯源数据的使用




Proposed Method
工作在一个迭代的反馈环：
“The deviation analyzer” 偏差分析器：检查系统日志以识别异常事件
（使用LOF模型对原始日志进行处理，生成异常进程及其直接谱系的过滤图）


日志结构与标记：采用一种映射机制，将分类变量转换为数值表示，同时保持双向映射以进行结果解释


异常值检测：首先，我们通过去除重复项来对系统日志进行预处理，以确保分析独特的过程-对象交互。用于异常检测的特征包括日志，使用Standard Scaleer对其进行标准化，以保证特征缩放的统一性。

    如果某个特征的数值范围远大于另一个特征，模型可能会过分关注范围大的特征。标准化旨在解决这个问题，使所有特征都处于一个相对统一的尺度上，便于模型学习和优化



过滤图的创建。基于检测到的异常事件偏差分析器识别执行这些事件(图2c中红色椭圆形)的进程。然后，对于识别出的每个异常进程，偏差分析器提取：( 1 )通过fork调用识别出进程的直接祖先，通过将对象标识符与异常进程标识符进行匹配来识别；( 2 )通过检查以异常进程为父进程的fork事件发现进程的直接后代，选择“one-hop lineage stems” 源于系统级起源图的一个众所周知的性质：其中一个进程负责在两个对象之间传输数据。

    指一个数据对象（如表、列或文件）的直接上游来源​。它关注的是最接近当前数据的、无需跨越中间层的原始起点。


“The graph analyzer” 图分析器：处理异常事件，构建图，精简出良性节点，并将可疑节点聚类成社区。+
（以上一步得出的结果作为输入，图分析器检查进程之间的关系，识别潜在的感染点，精简良性节点，并使用社区检测算法对可疑节点进行聚类。）


SHIELD侧重于通过 sockets 发起来自实体的攻击，这些接口作为受害者系统与外部实体之间的连接点。socket是发起攻击的对象。我们将所有这样的外部插座称为初始感染点


图分析器将可疑标签从初始感染点传播到溯源图中的其他节点；然后，将这些标签传播到从这些可疑进程接收数据的节点。标签因此被传播到路径中存在的所有实体。


对未感染子图进行精简。在标签传播完毕后，图分析器会对所有未被标记的节点进行剪枝，因此被认为是不重要的


将Louvain算法应用到图中，将相关节点聚类成社区，以识别可能在协同攻击活动中共同工作的进程组。我们选择这个算法是因为：( 1 )它可以有效地处理大规模的高维图，( 2 )它以产生高模划分而闻名，( 3 )先前的研究已经证明了它在类似任务中的有效性[ 25 ]。这种选择的进一步动机是基于对APT行为的关键观察：与攻击相关的活动通常在起源图中形成密集的、相互连接的社区，恶意进程之间表现出更高程度的相互作用。


“The LLM analyzer” LLM分析器：对这些社区进行评估，识别攻击模式并分配置信度分数。
LLM分析器模块构成了SHIELD流水线的第三个模块。LLM分析器以图分析器识别的社区为基础，对社区节点对应的系统事件进行处理，从而检测恶意行为。LLM分析器检查操作的关系和时间序列，确定是否观察到攻击，提供置信度评分，并将恶意事件映射到杀伤链的相应阶段。 当LLM推断社区中的事件具有高度可疑性时，用置信度得分对约简图中的相应节点进行标记；然后遍历该图，并将所有可追踪节点(过程和对象)及其对应的边(事件)发送给时间关联引擎。


该方法采用三阶段思维链( CoT )推理框架，对复杂的攻击场景进行有条理的分析。在初始阶段，LLM利用自身的内部知识来识别偏离预期的系统行为模式，例如在敏感目录中未授权的文件写入、意外的网络连接或异常的进程催生。显示这些可疑活动的过程或LLM不知道的过程将被标记，以便进一步调查。在第二阶段，LLM分析时序与每个标记过程相关的动作队列，识别可能指示妥协( e.g . ,一个Web服务器进程,它会做出意想不到的文件系统修改或建立不寻常的网络连接)的可疑模式。最后，在第三阶段，LLM调查社区中的过程间关系，突出表明有凝聚力的攻击摘要的模式。我们在附录A的算法中对该方法进行了形式化描述，图4给出了分析的示意图。在多阶段分析之后，LLM分配置信度得分。基于先前的工作，表明LLMs在评分尺度上的表现优于分类[ 32 ]，并利用弗雷塔斯等人使用0 . 9的置信度阈值来转发有效应答[ 7 ]，我们开发了置信度评分机制。我们的方法根据检测到的攻击序列赋予置信度分数( σa )：对于完整的攻击序列≥0.9，0。8 {\textasciitilde} 0 . 9为部分攻击序列，0 . 7 {\textasciitilde} 0 . 8为检测到的可疑模式。


“The temporal correlation engine” 时间关联引擎：保存历史攻击数据，跨时间关联事件，必要时重新发起分析，保证持续自适应的威胁检测。
（时序关联引擎作为SHIELD的编排模块，同时管理检测到的威胁的优先级排序和长期攻击监测的时序方面。它通过两种主要机制来处理从LLM分析器接收到的攻击集合：用于威胁评估的动态集合集成和用于内存管理的滚动起源更新。）























