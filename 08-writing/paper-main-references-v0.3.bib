	file = {已提交版本:C\:\\Users\\35393\\Zotero\\storage\\VSD8H5ZC\\Rani 等 - 2024 - TTPXHunter actionable threat intelligence extraction as TTPs from finished cyber threat reports.pdf:application/pdf},
