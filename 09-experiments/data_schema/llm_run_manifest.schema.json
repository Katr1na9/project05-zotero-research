{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schema/llm_run_manifest.schema.json",
  "title": "Project05 LLM Phase 1 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "condition_id",
    "split",
    "input_manifest_sha256",
    "config_sha256",
    "contract_sha256",
    "prompt_sha256",
    "model_lock",
    "stage_hash_chain",
    "result_sha256",
    "status"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "condition_id": {
      "type": "string",
      "enum": [
        "rule_compiler",
        "general_compiler",
        "security_compiler",
        "general_structured",
        "general_direct"
      ]
    },
    "split": {
      "type": "string",
      "enum": ["development", "test", "atomic-pilot"]
    },
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "model_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_role", "model_id", "revision", "weights_sha256"],
      "properties": {
        "model_role": {"type": "string"},
        "model_id": {"type": "string"},
        "revision": {"type": ["string", "null"]},
        "weights_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "stage_hash_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage1_prompt_sha256",
        "stage1_raw_sha256",
        "admission_sha256",
        "stage2_input_sha256",
        "stage2_prompt_sha256",
        "stage2_raw_sha256",
        "final_result_sha256"
      ],
      "properties": {
        "stage1_prompt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "stage1_raw_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "admission_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "stage2_input_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "stage2_prompt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "stage2_raw_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "final_result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "failed"]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "nullable_sha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    }
  }
}
