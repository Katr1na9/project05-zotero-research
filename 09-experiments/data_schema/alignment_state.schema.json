{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Katr1na9/project05-zotero-research/schemas/alignment_state.schema.json",
  "title": "AlignmentState",
  "description": "The partially observed evidence state after aligning CTI behavior claims with local evidence claims at one acquisition step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id",
    "case_id",
    "run_id",
    "step_index",
    "mask_strategy",
    "visible_claim_ids",
    "hidden_claim_ids",
    "coverage",
    "alignment_quality",
    "candidate_hypotheses",
    "supportable_granularity",
    "budget",
    "remaining_action_ids"
  ],
  "properties": {
    "state_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}.*$"
    },
    "run_id": {
      "type": "string"
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "mask_strategy": {
      "type": "string",
      "enum": [
        "none",
        "random",
        "type",
        "stage",
        "discriminative",
        "conflict_injection",
        "open_set"
      ]
    },
    "mask_intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "random_seed": {
      "type": "integer"
    },
    "visible_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hidden_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recovered_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "matched_cti_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unmatched_cti_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "matched_cti_edge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unmatched_cti_edge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cti_node_coverage",
        "cti_edge_coverage",
        "critical_gap_count"
      ],
      "properties": {
        "cti_node_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cti_edge_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stage_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "evidence_type_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "critical_gap_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "alignment_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_score_mean",
        "alignment_score_min",
        "conflict_count"
      ],
      "properties": {
        "alignment_score_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alignment_score_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conflict_count": {
          "type": "integer",
          "minimum": 0
        },
        "unexplained_local_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conflict_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "candidate_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "hypothesis_type",
          "label",
          "score"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "hypothesis_type": {
            "type": "string",
            "enum": [
              "technique",
              "tactic",
              "intent",
              "campaign",
              "actor_cluster",
              "named_actor",
              "unknown"
            ]
          },
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supporting_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "contradicting_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "discriminability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_entropy": {
          "type": "number",
          "minimum": 0
        },
        "top2_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shared_ttp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unique_evidence_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "supportable_granularity": {
      "type": "string",
      "enum": [
        "G0_unknown",
        "G1_technique",
        "G2_tactic_intent",
        "G3_campaign",
        "G4_actor_cluster",
        "G5_named_actor"
      ]
    },
    "granularity_rationale": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_total",
        "budget_used"
      ],
      "properties": {
        "budget_total": {
          "type": "number",
          "minimum": 0
        },
        "budget_used": {
          "type": "number",
          "minimum": 0
        },
        "budget_remaining": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": false,
      "default": []
    },
    "remaining_action_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stop_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "should_stop": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "target_granularity_reached",
            "budget_exhausted",
            "no_action_available",
            "insufficient_expected_gain",
            "requires_human_review",
            "continue"
          ]
        },
        "explanation": {
          "type": "string"
        }
      }
    }
  }
}
