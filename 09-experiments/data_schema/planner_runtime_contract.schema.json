{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/planner_runtime_contract.schema.json",
  "title": "Project05 Depth-2 and ML runtime information-boundary contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_id",
    "version",
    "status",
    "created_utc",
    "scope",
    "planner_visibility",
    "ml_feature_contract",
    "leakage_controls",
    "statistical_unit"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "frozen_for_new_runs"},
    "created_utc": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_families", "official_external_implementation_claimed"],
      "properties": {
        "planner_families": {
          "type": "array",
          "const": ["project05_depth2_public", "project05_xgboost_policy", "project05_logistic_policy"]
        },
        "official_external_implementation_claimed": {"const": false}
      }
    },
    "planner_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "state", "action", "recursive_forbidden_keys"],
      "properties": {
        "config": {"$ref": "#/$defs/visibilitySpec"},
        "state": {"$ref": "#/$defs/visibilitySpec"},
        "action": {"$ref": "#/$defs/visibilitySpec"},
        "recursive_forbidden_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "ml_feature_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "labels_runtime_visible", "feature_source"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "labels_runtime_visible": {"const": false},
        "feature_source": {"const": "allowlisted_public_config_state_action_only"}
      }
    },
    "leakage_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_allowlist_required",
        "recoverable_outcomes_visible",
        "mask_membership_visible",
        "realized_channel_state_visible_before_action",
        "target_case_labels_visible",
        "selector_invariance_tests_required"
      ],
      "properties": {
        "runtime_allowlist_required": {"const": true},
        "recoverable_outcomes_visible": {"const": false},
        "mask_membership_visible": {"const": false},
        "realized_channel_state_visible_before_action": {"const": false},
        "target_case_labels_visible": {"const": false},
        "selector_invariance_tests_required": {"const": true}
      }
    },
    "statistical_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "repeated", "pseudoreplication_forbidden"],
      "properties": {
        "independent": {"const": "case_or_attack_chain"},
        "repeated": {"const": "mask_strategy_x_mask_intensity_x_seed"},
        "pseudoreplication_forbidden": {"const": true}
      }
    }
  },
  "$defs": {
    "visibilitySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_level_fields", "nested_fields"],
      "properties": {
        "top_level_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "nested_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
