{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schema/m3star-blind-candidate-qualification-v0.1.json",
  "title": "Project05 M3* Blind Candidate Qualification Report",
  "type": "object",
  "required": [
    "report_id",
    "status",
    "report_created_utc",
    "candidate_pool_id",
    "candidate_pool_sha256",
    "candidate_upper_bound_audited",
    "curation_and_seal_separation",
    "non_consuming_disclosure_boundary",
    "source_artifact_hash_ledger_id",
    "source_results",
    "reported_qualified_count",
    "qualified_cases",
    "all_qualified_cases_retained",
    "qualification_rules_changed_after_access",
    "case_selection_used_model_outputs"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "curator_qualification_complete"
    },
    "report_created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_pool_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_pool_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_upper_bound_audited": {
      "const": 102
    },
    "curation_and_seal_separation": {
      "$ref": "#/$defs/roleSeparation"
    },
    "non_consuming_disclosure_boundary": {
      "$ref": "#/$defs/disclosureBoundary"
    },
    "source_artifact_hash_ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "source_results": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/sourceResult"
      }
    },
    "reported_qualified_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 102
    },
    "qualified_cases": {
      "type": "array",
      "maxItems": 102,
      "items": {
        "$ref": "#/$defs/qualifiedCase"
      }
    },
    "all_qualified_cases_retained": {
      "const": true
    },
    "qualification_rules_changed_after_access": {
      "const": false
    },
    "case_selection_used_model_outputs": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "roleSeparation": {
      "type": "object",
      "required": [
        "curation_team_id",
        "model_development_team_id",
        "ground_truth_custodian_id",
        "teams_are_disjoint",
        "curator_blind_to_model_outputs",
        "model_developers_blind_to_candidate_payloads",
        "ground_truth_custodian_distinct_from_curator_and_model_developer"
      ],
      "properties": {
        "curation_team_id": {
          "type": "string",
          "minLength": 1
        },
        "model_development_team_id": {
          "type": "string",
          "minLength": 1
        },
        "ground_truth_custodian_id": {
          "type": "string",
          "minLength": 1
        },
        "teams_are_disjoint": {
          "const": true
        },
        "curator_blind_to_model_outputs": {
          "const": true
        },
        "model_developers_blind_to_candidate_payloads": {
          "const": true
        },
        "ground_truth_custodian_distinct_from_curator_and_model_developer": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "disclosureBoundary": {
      "type": "object",
      "required": [
        "telemetry_contents_returned_to_model_development",
        "labels_returned_to_model_development",
        "ground_truth_returned_to_model_development",
        "attack_narratives_returned_to_model_development",
        "cost_values_returned_to_model_development",
        "model_outputs_opened_during_qualification"
      ],
      "properties": {
        "telemetry_contents_returned_to_model_development": {
          "const": false
        },
        "labels_returned_to_model_development": {
          "const": false
        },
        "ground_truth_returned_to_model_development": {
          "const": false
        },
        "attack_narratives_returned_to_model_development": {
          "const": false
        },
        "cost_values_returned_to_model_development": {
          "const": false
        },
        "model_outputs_opened_during_qualification": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "sourceResult": {
      "type": "object",
      "required": [
        "source_id",
        "risk_tier",
        "planned_candidate_upper_bound",
        "qualified_count",
        "not_qualified_count",
        "attrition_reason_counts",
        "all_available_official_artifacts_audited"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "risk_tier": {
          "enum": [
            "A",
            "B"
          ]
        },
        "planned_candidate_upper_bound": {
          "type": "integer",
          "minimum": 1
        },
        "qualified_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_qualified_count": {
          "type": "integer",
          "minimum": 0
        },
        "attrition_reason_counts": {
          "$ref": "#/$defs/attritionReasons"
        },
        "all_available_official_artifacts_audited": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "attritionReasons": {
      "type": "object",
      "properties": {
        "upper_bound_not_instantiated": {
          "type": "integer",
          "minimum": 0
        },
        "official_artifact_unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "publisher_checksum_mismatch": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete_campaign_boundary": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete_host_or_sensor_coverage": {
          "type": "integer",
          "minimum": 0
        },
        "not_multi_stage": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_scenario_family": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_campaign_execution": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_telemetry_capture": {
          "type": "integer",
          "minimum": 0
        },
        "preblind_campaign_overlap": {
          "type": "integer",
          "minimum": 0
        },
        "parameter_or_representation_variant": {
          "type": "integer",
          "minimum": 0
        },
        "cost_measurement_scope_unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "license_or_access_failure": {
          "type": "integer",
          "minimum": 0
        },
        "other_documented": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "qualifiedCase": {
      "type": "object",
      "required": [
        "qualification_case_id",
        "source_id",
        "source_cluster_id",
        "source_release_id",
        "source_artifact_sha256",
        "scenario_family_sha256",
        "attack_chain_definition_sha256",
        "campaign_execution_sha256",
        "telemetry_capture_sha256",
        "original_telemetry_present",
        "multi_stage_attack_chain_present",
        "full_campaign_time_window_included",
        "all_in_scope_campaign_hosts_combined",
        "not_a_host_slice",
        "not_a_time_slice",
        "not_a_mask_variant",
        "not_a_parameter_only_variant",
        "not_used_in_model_development",
        "cost_measurement_scope_supported",
        "ground_truth_sealed",
        "cost_values_sealed_from_model_development",
        "ground_truth_seal_id",
        "cost_measurement_seal_id"
      ],
      "properties": {
        "qualification_case_id": {
          "type": "string",
          "pattern": "^QB-[0-9]{3}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "source_release_id": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenario_family_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attack_chain_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "campaign_execution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "telemetry_capture_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_telemetry_present": {
          "const": true
        },
        "multi_stage_attack_chain_present": {
          "const": true
        },
        "full_campaign_time_window_included": {
          "const": true
        },
        "all_in_scope_campaign_hosts_combined": {
          "const": true
        },
        "not_a_host_slice": {
          "const": true
        },
        "not_a_time_slice": {
          "const": true
        },
        "not_a_mask_variant": {
          "const": true
        },
        "not_a_parameter_only_variant": {
          "const": true
        },
        "not_used_in_model_development": {
          "const": true
        },
        "cost_measurement_scope_supported": {
          "const": true
        },
        "ground_truth_sealed": {
          "const": true
        },
        "cost_values_sealed_from_model_development": {
          "const": true
        },
        "ground_truth_seal_id": {
          "type": "string",
          "minLength": 1
        },
        "cost_measurement_seal_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
