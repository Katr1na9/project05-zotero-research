{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/external_ground_truth_bundle.schema.json",
  "title": "Project05 external actor and analyst-utility ground truth bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "version", "created_utc", "records", "source_files"],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_utc": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "items": {"oneOf": [{"$ref": "#/$defs/actorRecord"}, {"$ref": "#/$defs/utilityRecord"}]}
    },
    "source_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceFile"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "record_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_organization",
        "source_document_id",
        "source_document_sha256",
        "external_to_project",
        "independent_of_case_compilation",
        "adjudicated_utc"
      ],
      "properties": {
        "source_organization": {"type": "string", "minLength": 1},
        "source_document_id": {"type": "string", "minLength": 1},
        "source_document_sha256": {"$ref": "#/$defs/sha256"},
        "external_to_project": {"const": true},
        "independent_of_case_compilation": {"const": true},
        "adjudicated_utc": {"type": "string", "format": "date-time"}
      }
    },
    "normalizedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "source_file_sha256", "record_sha256"],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id", "case_id", "ground_truth_type", "actor_label",
        "label_scope", "confidence", "provenance", "normalized_source"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "ground_truth_type": {"const": "actor_attribution"},
        "actor_label": {"type": "string", "minLength": 1},
        "label_scope": {"enum": ["actor", "group", "campaign"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "normalized_source": {"$ref": "#/$defs/normalizedSource"}
      }
    },
    "utilityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id", "case_id", "ground_truth_type", "evaluation_id",
        "evaluated_output_id", "utility_score", "utility_scale",
        "analyst_panel_id", "provenance", "normalized_source"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "ground_truth_type": {"const": "analyst_utility"},
        "evaluation_id": {"type": "string", "minLength": 1},
        "evaluated_output_id": {"type": "string", "minLength": 1},
        "utility_score": {"type": "number"},
        "utility_scale": {"type": "string", "minLength": 1},
        "analyst_panel_id": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "normalized_source": {"$ref": "#/$defs/normalizedSource"}
      }
    }
  }
}
