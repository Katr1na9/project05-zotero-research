{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Katr1na9/project05-zotero-research/schemas/action_prior_profile.schema.json",
  "title": "Project05 development-derived action-prior profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "status",
    "created_utc",
    "training_scope",
    "application_scope",
    "leakage_boundary",
    "training_summary",
    "actions",
    "case_channel_priors",
    "input_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "frozen_development_derived"},
    "created_utc": {"type": "string", "format": "date-time"},
    "training_scope": {"$ref": "#/$defs/caseScope"},
    "application_scope": {"$ref": "#/$defs/caseScope"},
    "leakage_boundary": {"type": "string", "minLength": 1},
    "training_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_count", "mean_granularity_gain", "mean_coverage_delta"],
        "properties": {
          "observation_count": {"type": "integer", "minimum": 1},
          "mean_granularity_gain": {"type": "number", "minimum": 0, "maximum": 5},
          "mean_coverage_delta": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "action_id", "action_type", "expected_effects", "provenance"],
        "properties": {
          "case_id": {"type": "string"},
          "action_id": {"type": "string"},
          "action_type": {"type": "string"},
          "expected_effects": {"$ref": "#/$defs/effects"},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expected_granularity_gain",
              "expected_uncertainty_reduction",
              "expected_over_attribution_risk_reduction",
              "expected_conflict_resolution",
              "expected_coverage_delta"
            ],
            "properties": {
              "expected_granularity_gain": {"const": "development_measured_by_action_type"},
              "expected_uncertainty_reduction": {"const": "legacy_expert_prior"},
              "expected_over_attribution_risk_reduction": {"const": "legacy_expert_prior"},
              "expected_conflict_resolution": {"const": "legacy_expert_prior"},
              "expected_coverage_delta": {"const": "development_measured_by_action_type"}
            }
          }
        }
      }
    },
    "case_channel_priors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "channel_reliability", "provenance"],
        "properties": {
          "case_id": {"type": "string"},
          "channel_reliability": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "provenance": {"const": "legacy_expert_prior_not_empirically_calibrated"}
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  },
  "$defs": {
    "caseScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids"],
      "properties": {
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_granularity_gain",
        "expected_uncertainty_reduction",
        "expected_over_attribution_risk_reduction",
        "expected_conflict_resolution",
        "expected_coverage_delta"
      ],
      "properties": {
        "expected_granularity_gain": {"type": "number", "minimum": 0, "maximum": 5},
        "expected_uncertainty_reduction": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_over_attribution_risk_reduction": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_conflict_resolution": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_coverage_delta": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
