{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project05.local/schemas/real_case_cohort.schema.json",
  "title": "Project05 real-only canonical case cohort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cohort_id",
    "version",
    "status",
    "created_utc",
    "renaming_policy",
    "phase_policy",
    "cases",
    "toy_exclusions",
    "unseen_boundary"
  ],
  "properties": {
    "cohort_id": {"const": "project05-real-case-cohort-v0.3"},
    "version": {"const": "0.3.0"},
    "status": {"const": "frozen"},
    "created_utc": {"type": "string", "format": "date-time"},
    "renaming_policy": {"const": "canonical_alias_only_preserve_source_ids_paths_and_files"},
    "phase_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C01_C03", "C04_C09"],
      "properties": {
        "C01_C03": {"const": "calibration"},
        "C04_C09": {"const": "development_repeat_validation"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/case"}
    },
    "toy_exclusions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/toyExclusion"}
    },
    "unseen_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_C13_plus", "canonical_C10_plus"],
      "properties": {
        "source_C13_plus": {"const": "sealed"},
        "canonical_C10_plus": {"const": "unassigned_and_sealed"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "declared_digest_source"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "declared_digest_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_case_id",
        "source_case_id",
        "source_case_path",
        "source_case_config_sha256",
        "upstream_case_id",
        "phase",
        "replay_artifacts"
      ],
      "properties": {
        "canonical_case_id": {"type": "string", "pattern": "^C0[1-9]$"},
        "source_case_id": {"type": "string", "pattern": "^C(?:0[4-9]|1[0-2]).*$"},
        "source_case_path": {"type": "string", "minLength": 1},
        "source_case_config_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_case_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["calibration", "development"]},
        "replay_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "toyExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_case_id",
        "source_case_path",
        "source_case_config_sha256",
        "reason",
        "permitted_use",
        "formal_experiment_included",
        "paper_result_included"
      ],
      "properties": {
        "source_case_id": {"type": "string", "pattern": "^C0[1-3].*$"},
        "source_case_path": {"type": "string", "minLength": 1},
        "source_case_config_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"const": "no_replayable_original_event_data_for_operational_acquisition_cost"},
        "permitted_use": {"const": "toy_unit_and_interface_tests_only"},
        "formal_experiment_included": {"const": false},
        "paper_result_included": {"const": false}
      }
    }
  }
}
