{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Katr1na9/project05-zotero-research/schemas/corroboration_profile.schema.json",
  "title": "Project05 claim source-group profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "status",
    "created_utc",
    "scope",
    "grouping_unit",
    "independence_boundary",
    "assignments",
    "node_audit"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "frozen_mapping",
        "retired"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_ids"
      ],
      "properties": {
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]{2}.*$"
          }
        }
      }
    },
    "grouping_unit": {
      "const": "provider_or_source_family"
    },
    "independence_boundary": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "claim_id",
          "source_group",
          "basis"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "claim_id": {
            "type": "string"
          },
          "source_group": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "node_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "node_id",
          "required_claim_count",
          "source_group_count",
          "claim_count_overstates_source_groups"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "required_claim_count": {
            "type": "integer",
            "minimum": 0
          },
          "source_group_count": {
            "type": "integer",
            "minimum": 0
          },
          "claim_count_overstates_source_groups": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
