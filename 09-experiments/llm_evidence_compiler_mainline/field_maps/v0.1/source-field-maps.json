          "subject_type": "process",
          "predicate": "accessed",
          "object_type": "file",
          "subject_rule": {"transform": "field", "fields": ["process_name"]},
          "object_rule": {"transform": "field", "fields": ["file_path"]},
          "time_rule": {"transform": "field", "fields": ["timestamp"]},
          "incompatible_predicates": ["executed", "connected_to"]
        },
        {
          "template_id": "socbed_network_connected_v1",
          "subject_type": "network_address",
          "predicate": "connected_to",
          "object_type": "network_endpoint",
          "subject_rule": {"transform": "field", "fields": ["source_address"]},
          "object_rule": {
            "transform": "join_host_port",
