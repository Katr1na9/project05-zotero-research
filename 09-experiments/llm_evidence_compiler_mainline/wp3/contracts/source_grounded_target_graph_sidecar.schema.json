{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Katr1na9/project05-zotero-research/schemas/wp3/source_grounded_target_graph_sidecar.schema.json",
  "title": "SourceGroundedTargetGraphSidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "request_id",
    "component_id",
    "component_revision",
    "component_license",
    "upstream_component_runtime_executed",
    "third_party_code_copied",
    "status",
    "nodes",
    "edges",
    "rejections",
    "abstention_reasons",
    "counts"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "adapter_id": {"const": "project05-clean-room-component-graph-adapter"},
    "adapter_version": {"const": "0.1.0"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-F0-9]{24}$"},
    "component_id": {"type": "string", "minLength": 1},
    "component_revision": {"type": "string", "minLength": 1},
    "component_license": {"type": "string", "minLength": 1},
    "upstream_component_runtime_executed": {"type": "boolean"},
    "third_party_code_copied": {"const": false},
    "status": {"enum": ["completed", "completed_with_rejections", "abstained"]},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "rejections": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejection"}
    },
    "abstention_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_triplets", "accepted_edges", "rejected_triplets", "output_nodes"],
      "properties": {
        "input_triplets": {"type": "integer", "minimum": 0},
        "accepted_edges": {"type": "integer", "minimum": 0},
        "rejected_triplets": {"type": "integer", "minimum": 0},
        "output_nodes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "source_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "record_id", "record_sha256", "field_path"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^ART-[A-F0-9]{16}$"},
        "record_id": {"type": "string", "pattern": "^REC-[A-F0-9]{16}$"},
        "record_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "field_path": {"type": "string", "minLength": 1},
        "location": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "request_id",
        "entity_type",
        "normalized_value",
        "surface_values",
        "source_pointers",
        "controller_eligible"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^SGNODE-[A-F0-9]{24}$"},
        "request_id": {"type": "string", "pattern": "^REQ-[A-F0-9]{24}$"},
        "entity_type": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "surface_values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_pointers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_pointer"}
        },
        "controller_eligible": {"const": false}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "request_id",
        "subject_node_id",
        "object_node_id",
        "relation",
        "normalized_relation",
        "source_pointer",
        "support_sentence",
        "support_sentence_sha256",
        "support_method",
        "mechanical_eligibility",
        "controller_eligible"
      ],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^SGEDGE-[A-F0-9]{24}$"},
        "request_id": {"type": "string", "pattern": "^REQ-[A-F0-9]{24}$"},
        "subject_node_id": {"type": "string", "pattern": "^SGNODE-[A-F0-9]{24}$"},
        "object_node_id": {"type": "string", "pattern": "^SGNODE-[A-F0-9]{24}$"},
        "relation": {"type": "string", "minLength": 1},
        "normalized_relation": {"type": "string", "minLength": 1},
        "source_pointer": {"$ref": "#/$defs/source_pointer"},
        "support_sentence": {"type": "string", "minLength": 1},
        "support_sentence_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "support_method": {"const": "minimal_same_record_sentence_casefold_v0.1"},
        "mechanical_eligibility": {"const": "passed"},
        "controller_eligible": {"const": false}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triplet_id", "reason_codes"],
      "properties": {
        "triplet_id": {"type": "string", "minLength": 1},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
