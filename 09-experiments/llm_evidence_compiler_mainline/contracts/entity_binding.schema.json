{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Katr1na9/project05-zotero-research/schemas/entity_binding.schema.json",
  "title": "EntityBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "request_id",
    "entity_key",
    "entity_role",
    "entity_type",
    "surface_value",
    "normalized_value",
    "scope",
    "admitted_claim_ids",
    "normalization_method"
  ],
  "properties": {
    "binding_id": {"type": "string", "pattern": "^BIND-[A-F0-9]{24}$"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-F0-9]{24}$"},
    "entity_key": {"type": "string", "pattern": "^ENT-[A-F0-9]{24}$"},
    "entity_role": {"enum": ["subject", "object"]},
    "entity_type": {"type": "string", "minLength": 1},
    "surface_value": {"type": "string", "minLength": 1},
    "normalized_value": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_status"],
      "properties": {
        "scope_status": {"enum": ["known", "unknown"]},
        "host_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "process_id": {"type": "string", "minLength": 1}
      }
    },
    "time_window": {"type": "object"},
    "admitted_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^ADM-[A-F0-9]{24}$"},
      "uniqueItems": true
    },
    "normalization_method": {"const": "frozen_surface_nfkc_casefold_v0.1"}
  }
}

