  "gradient_checkpointing": true,
  "maximum_gradient_norm": 1.0,
  "seed": 2026071601,
  "loss_mask": "assistant_target_only",
  "checkpointing": {
    "save_strategy": "epoch",
    "epochs": [1, 2, 3],
